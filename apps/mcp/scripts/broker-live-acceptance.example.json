{
  "schema_version": 1,
  "release": {
    "artifact": "isolated npm install of @trusty-squire/mcp@VERSION",
    "version": "VERSION"
  },
  "nativeLaunch": {
    "command": "npx",
    "args": ["-y", "@trusty-squire/mcp@VERSION", "server"],
    "expectedVersion": "VERSION",
    "timeoutMs": 35000
  },
  "profileDir": "/absolute/worktree/test-identity/profile",
  "configHome": "/absolute/worktree/test-identity/config",
  "accountId": "enrolled-test-account-id",
  "credential_policy": "force_fresh",
  "credential_cleanup_policy": "retain",
  "services": [
    {
      "provider": "resend",
      "providerAccountId": "expected-resend-account-id",
      "url": "https://resend.com/api-keys",
      "allowedHosts": ["api.resend.com"],
      "driver": "resend-driver.mjs",
      "authPattern": "expected account evidence",
      "provisionPattern": "trusty-squire-run label",
      "oldCredentialControl": {
        "provider_credential_id": "existing-provider-key-id",
        "vault_reference": "vault://existing-resend-reference"
      }
    },
    {
      "provider": "neon",
      "providerAccountId": "expected-neon-account-id",
      "url": "https://console.neon.tech/app/settings/api-keys",
      "allowedHosts": ["console.neon.tech"],
      "driver": "neon-driver.mjs",
      "authPattern": "expected account evidence",
      "provisionPattern": "trusty-squire-run label",
      "oldCredentialControl": {
        "provider_credential_id": "existing-provider-key-id",
        "vault_reference": "vault://existing-neon-reference"
      }
    },
    {
      "provider": "xata",
      "providerAccountId": "expected-xata-account-id",
      "url": "https://app.xata.io/settings/api-keys",
      "allowedHosts": ["api.xata.io"],
      "driver": "xata-driver.mjs",
      "authPattern": "expected account evidence",
      "provisionPattern": "trusty-squire-run label",
      "oldCredentialControl": {
        "provider_credential_id": "existing-provider-key-id",
        "vault_reference": "vault://existing-xata-reference"
      }
    }
  ]
}
