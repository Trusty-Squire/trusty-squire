        Zambia\n        </option>\n        <option\n          value='ZW'\n          \n          data-currency-code=\"USD\"\n          data-currency-symbol=\"$\"\n        >\n          Zimbabwe\n        </option>\n          </select>\n          <div\n            class=\"hidden\"\n          >\n<svg-icon\n  src='icon-plus'\n  class='block text-white'\n\n  \n    style='--icon-size: 12px;'\n  \n\n  \n  \n></svg-icon>\n</div>\n          <label\n            for=\"footer-legalcurrencyForm_country_code\"\n            class=\"absolute caption duration-300 transform -translate-y-2.5 scale-75 top-3.5  z-10 origin-[0]  peer-disabled:text-t-border peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 rtl:peer-focus:translate-x-1/4 rtl:peer-focus:left-auto \"\n          >\n             \n          </label>\n        </div></country-select>\n</form>\n</div>\n</div>\n\n\n</div><div id=\"shopify-section-sections--16568793727058__klaviyo-bis-drawer\" class=\"shopify-section shopify-section-group-footer-group\">\n\n\n\n<modal-dialog\n    cloak\n    type='drawer'\n    id='klaviyo_back_in_stock_drawer'\n\n    \n      url=''\n    \n\n    \n\n    \n      anchor='right'\n    \n\n    \n      close-on-backdrop-click='true'\n    \n\n    \n\n    \n      header-classes='!px-[18px] md:!px-[23px] !pt-[22px] !pb-[21px]'\n    \n\n    \n      close-icon-size='15'\n    \n\n    \n      close-icon-position='right'\n    \n\n    \n      dialog-classes='!block !max-w-[375px] md:!max-w-[394px]'\n    \n\n    \n  >\n    <h5 slot='header' class='h5  !text-lg'>\n          join the waitlist\n        </h5><div class='klaviyo-back-in-stock-drawer px-[18px] mt-10'>\n    <form id='klaviyo_back_in_stock_form'>\n      <div class='mb-8 md:mb-5 md:[&_p]:text-[15px] md:[&_p]:leading-[1.7]'><p>To be notified when this item becomes available, please enter your email below.</p></div>\n\n      <div class=\"mb-[22px] md:mb-[21px] group\">\n        <div\n          class=\"relative w-full group peer\"\n          \n        >\n          <input\n            class=\"  text-base md:text-body block w-full border appearance-none text-t-foreground disabled:text-t-border rounded-forms-radius px-sm-forms-padding lg:px-lg-forms-padding pt-sm-forms-padding lg:pt-lg-forms-padding h-sm-forms-inputheight lg:h-lg-forms-inputheight bg-gray-50 bg-t-background border-t-foreground-secondary disabled:border-t-border focus:outline-none focus:ring-0 focus:border-t-foreground peer group-[[error]]:ring-u-error group-[[error]]:border-[transparent] group-[[error]]:ring-2 !border-t-0 !border-x-0 !border-b-p-darkest !rounded-none\"\n            placeholder=\"\"\n            type=\"email\"\n            id=\"bis_email\"\n            name=\"email\"\n            \n              value=\"\"\n            \n\n            \n\n            \n\n            \n\n            \n              required\n            \n\n            \n\n            \n\n            \n\n            \n          /><label\n            for=\"bis_email\"\n            class=\"lowercase !text-[15px] !top-0 !peer-focus:-translate-y-1  absolute caption duration-300 transform top-1.5 z-10 origin-[0] peer-disabled:text-t-border peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 rtl:peer-focus:translate-x-1/4 rtl:peer-focus:left-auto\"\n          >\n            Email\n          </label>\n        </div></div>\n<input type='hidden' id='bis_variant_id' value='42459592589394'>\n\n      <div class='mb-[23px] md:mb-[20px]'>\n<div class=\"inline-flex items-start justify-start gap-x-xs group/checkbox\">\n        <label\n          class=\"relative flex items-center cursor-pointer\"\n          for=\"newsletter_opt_in\"\n        >\n          <input\n            type=\"checkbox\"\n            class=\"w-[18px] h-[18px] relative transition-all border appearance-none cursor-pointer disabled:border-t-border size-4 peer border-blue-gray-200\"\n            id=\"newsletter_opt_in\"\n            value=\"\"\n            name=\"newsletter-opt-in\"\n            aria-labelledby=\"newsletter_opt_in_label\"\n\n            \n\n            \n\n            \n\n            \n\n            \n\n            \n\n            \n\n            \n\n            \n          />\n          <span\n            class=\"w-[18px] h-[18px] absolute transition-opacity opacity-0 pointer-events-none size-3 top-2/4 left-2/4 -translate-y-2/4 -translate-x-2/4 peer-checked:opacity-100 peer-disabled:border-t-border peer-disabled:text-t-border\"\n          >\n<svg-icon\n  src='icon-checkbox-tick'\n  class='block'\n\n  \n    style='--icon-size: 12px;'\n  \n\n  \n  \n></svg-icon>\n</span>\n        </label>\n        <label\n          class=\"mt-px cursor-pointer select-none  text-body group-has-[:disabled]/checkbox:text-t-border\"\n          for=\"newsletter_opt_in\"\n        >\n          <div>\n            <p id=\"newsletter_opt_in_label\" class=\"block text-body leading-none  group-has-[:disabled]/checkbox:text-t-disabled \">\n              Subscribe to the newsletter\n            </p></div>\n        </label>\n      </div>\n</div>\n\n      <div class='mb-8 md:mb-10 [&_a]:font-bold [&_a]:underline'><p>I agree to receive the colorpop newsletter to be the first to know about new collections, exclusive product launches, events and services available. By subscribing I agree to the colorpop <a href=\"https://colourpop.com/pages/privacy-policy\" target=\"_blank\" title=\"https://colourpop.com/pages/privacy-policy\">private policy </a></p></div>\n\n      <button class='btn max-w-full !text-[12px] lg:!text-[14px] !leading-[1.25]' variant='primary' type='submit'>register</button>\n    </form>\n<dialog-toggle modal-id='klaviyo_back_in_stock_drawer' class='!hidden inline-flex place-items-center w-full mt-10 bis-continue-shopping-btn' data-variant-id='false'><button\n        type='button'\n        name='close BIS drawer'\n        variant='primary'\n        class='btn !max-w-full'\n        aria-haspopup='dialog'\n        aria-controls='klaviyo_back_in_stock_drawer'\n      >\n        continue your shopping\n      </button>\n</dialog-toggle></div>\n  </modal-dialog><script>\n  document.addEventListener('DOMContentLoaded', function () {\n    const form = document.getElementById('klaviyo_back_in_stock_form')\n\n    form.addEventListener('submit', async (event) => {\n      event.preventDefault()\n\n      const email = document.getElementById('bis_email').value\n      const variantId = document.getElementById('bis_variant_id').value\n      const newsletterOptIn = document.getElementById('newsletter_opt_in').checked\n      const publicKey = ''\n\n      let bisFetchSuccess = false\n      let newsletterFetchSuccess = false\n\n      const bisUrl = `https://a.klaviyo.com/client/back-in-stock-subscriptions/?company_id=${publicKey}`\n\n      const bisPayload = {\n        data: {\n          type: 'back-in-stock-subscription',\n          attributes: {\n            profile: {\n              data: {\n                type: 'profile',\n                attributes: { email },\n              },\n            },\n            channels: ['EMAIL'],\n          },\n          relationships: {\n            variant: {\n              data: {\n                type: 'catalog-variant',\n                id: `$shopify:::$default:::${variantId}`,\n              },\n            },\n          },\n        },\n      }\n\n      const bisFetchOptions = {\n        method: 'POST',\n        headers: {\n          'Content-Type': 'application/json',\n          revision: '2025-01-15',\n        },\n        body: JSON.stringify(bisPayload),\n      }\n\n      const bisResponse = await fetch(bisUrl, bisFetchOptions)\n      if (bisResponse.ok) {\n        bisFetchSuccess = true\n      } else {\n        console.error('Back in stock subscription failed:', bisResponse)\n      }\n\n      if (newsletterOptIn) {\n        const newsletterUrl = `https://a.klaviyo.com/client/subscriptions/?company_id=${publicKey}`\n\n        const newsletterPayload = {\n          data: {\n            type: 'subscription',\n            attributes: {\n              profile: {\n                data: {\n                  type: 'profile',\n                  attributes: { email },\n                },\n              },\n            },\n            relationships: {\n              list: {\n                data: {\n                  type: 'list',\n                  id: 'Rk7yBD',\n                },\n              },\n            },\n          },\n        }\n\n        const newsletterFetchOptions = {\n          method: 'POST',\n          headers: {\n            'Content-Type': 'application/json',\n            revision: '2025-01-15',\n          },\n          body: JSON.stringify(newsletterPayload),\n        }\n\n        const newsletterResponse = await fetch(newsletterUrl, newsletterFetchOptions)\n        if (newsletterResponse.ok) {\n          newsletterFetchSuccess = true\n        } else {\n          console.error('Newsletter subscription failed:', newsletterResponse)\n        }\n      }\n\n      if (bisFetchSuccess && (newsletterOptIn ? newsletterFetchSuccess : true)) {\n        form.innerHTML = `<p class=\"!text-[15px]\">thank you, we will email you when the item is available for purchase again${\n          newsletterOptIn ? \", and you've joined the newsletter\" : ''\n        }.</p>`\n      } else if (bisFetchSuccess && !newsletterFetchSuccess) {\n        form.innerHTML = `<p class=\"!text-[15px]\">thank you, we will email you when the item is available for purchase again. However, the newsletter signup failed.</p>`\n      } else if (!bisFetchSuccess && newsletterFetchSuccess) {\n        form.innerHTML = `<p class=\"!text-[15px]\">Newsletter subscribed, but the product alert failed.</p>`\n      } else {\n        form.innerHTML = `<p class=\"!text-[15px]\">Something went wrong. Please try again later.</p>`\n      }\n\n      document.querySelector('.bis-continue-shopping-btn').classList.remove('!hidden')\n    })\n  })\n</script>\n\n\n\n</div>\n<!-- END sections: footer-group --></footer>\n\n        <ul hidden>\n          <li id='a11y-refresh-page-message'>\n            Choosing a selection results in a full page refresh.\n          </li>\n        </ul>\n\n<section id=\"shopify-section-cart-drawer-dialog\" class=\"shopify-section\">\n<modal-dialog\n    cloak\n    type='drawer'\n    id='cart-drawer-dialog'\n\n    \n      url=''\n    \n\n    \n\n    \n      anchor='right'\n    \n\n    \n      close-on-backdrop-click='true'\n    \n\n    \n\n    \n\n    \n      close-icon-size='15'\n    \n\n    \n      close-icon-position='right'\n    \n\n    \n\n    \n  >\n    \n<!-- ##entry##component-cart-total##endentry## -->\n<h6 slot='header' class='text-[18px] font-primary lowercase'>\n          Cart\n          (<span class='-px-[1px] inline-block'>\n            <cart-total translation='{ \"cart_count\": \"{\\u0026quot;one\\u0026quot;=\\u0026gt;\\u0026quot;{{ count }} item\\u0026quot;, \\u0026quot;other\\u0026quot;=\\u0026gt;\\u0026quot;{{ count }} items\\u0026quot;}\" }'>\n              <span class='sr-only'>0 items</span>\n            </cart-total></span\n          >)\n        </h6><!-- ##entry##core-cart-sections##endentry## -->\n\n\n<cart-sections\n  section-id='cart-drawer'\n  class='grid grid-cols-1 grid-rows-[minmax(auto,_1fr)_auto] h-full bg-p-lightest'\n  cloak\n  \n>\n  <div\n    class='grid grid-cols-1 place-items-start'\n  >\n    <div class='grid grid-cols-[160px_minmax(0,1fr)_auto] w-full pb-5'>\n      \n\n        <div class='col-span-full pt-4 px-sm'>\n          <h4 class='text-2xl lowercase font-medium'>your cart is empty</h4>\n          <a href='/collections/all' class='btn mt-5 text-sm w-full max-w-full' variant='primary'>continue shopping</a>\n          <p class='mt-5 text-base'>\n            <span class='block font-bold'>have a an account?</span>\n            log in to check out faster.\n          </p>\n        </div></div>\n  </div><div class='sticky bottom-0 z-[1] bg-p-lightest px-4 py-5 sm:p-6 drop-shadow grid grid-cols-1 gap-y-sm'><div class='grid grid-cols-1 gap-y-xs'><div class='grid grid-cols-2 gap-sm' role='status'>\n    <h2 class='font-semibold text-2xl lowercase'>subtotal</h2>\n\n    <p class='utility text-right text-2xl font-medium'>\n        <span class='sr-only'>Regular price</span>\n        <span class='inline-block pr-2'>\n          \n\n          \n        </span><span>$0.00</span>\n    </p>\n  </div>\n</div>\n<div class='flex flex-col gap-y-sm col-span-2'>\n      \n      <form\n        id='cart'\n        method='post'\n        action='/cart'\n      >\n        <button\n          form='cart'\n          type='submit'\n          variant='primary'\n          id='checkout'\n          name='checkout'\n          class='btn w-full max-w-full'\n          \n        >\n          check out\n        </button>\n      </form>\n    </div>\n    <div>\n      <small class='caption text-[12px]'>Taxes, discounts and shipping calculated at checkout.\n</small>\n    </div>\n  </div>\n</cart-sections>\n\n  </modal-dialog></section>\n\n\n        \n          <!-- ##entry##core-quickshop,core-main-product,core-swiper-with-media##endentry## -->\n<quick-shop modal-id='quick-shop-modal'>\n  \n  \n<modal-dialog\n    cloak\n    type='drawer'\n    id='quick-shop-modal'\n\n    \n      url=''\n    \n\n    \n\n    \n      anchor='right'\n    \n\n    \n      close-on-backdrop-click='true'\n    \n\n    \n\n    \n\n    \n      close-icon-size='15'\n    \n\n    \n      close-icon-position='right'\n    \n\n    \n\n    \n  >\n    <h5 slot='header' class='h5  !text-lg'>\n          choose your shade\n        </h5>\n  </modal-dialog>\n</quick-shop>\n\n        \n      </app-provider>\n<script defer type='module' src='//colourpop.com/cdn/shop/t/1268/assets/-core-aria-live-region.js?v=116834524600874240441784059954'></script><script defer type='module' src='//colourpop.com/cdn/shop/t/1268/assets/-predictive-search.js?v=125008003694344795541784059965'></script><script defer type='module' src='//colourpop.com/cdn/shop/t/1268/assets/-core-quickshop-toggle.js?v=158221037299977562741784059960'></script><script defer type='module' src='//colourpop.com/cdn/shop/t/1268/assets/-component-cart-total.js?v=102459906050135571001784059948'></script><script defer type='module' src='//colourpop.com/cdn/shop/t/1268/assets/-component-country-select.js?v=114194481290742017481784059949'></script><script defer type='module' src='//colourpop.com/cdn/shop/t/1268/assets/-core-main-product.js?v=139803985391472734591784059959'></script><script defer type='module' src='//colourpop.com/cdn/shop/t/1268/assets/-core-swiper-with-media.js?v=34838951310129856991784059961'></script><script defer type='module' src='//colourpop.com/cdn/shop/t/1268/assets/-component-product-ymal.js?v=132508'></script><script defer type='module' src='//colourpop.com/cdn/shop/t/1268/assets/-component-product-recommendations.js?v=163164835033770003081784059953'></script><script defer type='module' src='//colourpop.com/cdn/shop/t/1268/assets/-core-cart-sections.js?v=11879588415272108961784059955'></script><script defer type='module' src='//colourpop.com/cdn/shop/t/1268/assets/-core-quickshop.js?v=41341401130329059881784059960'></script><script defer type='module' src='//colourpop.com/cdn/shop/t/1268/assets/-core-dialog.js?v=120462631029997289301784059957'></script><script defer type='module' src='//colourpop.com/cdn/shop/t/1268/assets/-vendor-swiper.js?v=125545043974683086481784059967'></script><script defer type='module' src='//colourpop.com/cdn/shop/t/1268/assets/-core-dynamic-product-card.js?v=43528885293208975711784059957'></script>\n\n\n\n    <script>\n      const productCardsWithKlaviyoBisCta = document.querySelectorAll('.product-card-bis-cta')\n\n      if (productCardsWithKlaviyoBisCta.length > 0) {\n        productCardsWithKlaviyoBisCta.forEach((cta) => {\n          cta.addEventListener('click', (event) => {\n            document.querySelector('#bis_variant_id').value = event.currentTarget.dataset.variantId\n          })\n        })\n      }\n    </script>\n    <script defer src=\"https://static.shopmy.us/Affiliates/sms_aff_clicktrack.js?domain=colourpop.com&expires=30\"></script>\n  <style> @media only screen and (min-width: 768px) {div[data-tolstoy-element=\"tolstoy-carousel-container-ds0v0uoimgjk2\"] {display: none !important; }} @media only screen and (max-width: 767px) {div[data-tolstoy-element=\"tolstoy-carousel-container-qkm0x0pnze5jh\"] {display: none !important; }} </style>\n<div id=\"shopify-block-AdmdXU3VUQ3hMTm1rN__8764476057892802672\" class=\"shopify-block shopify-app-block\"><link rel=\"preconnect\" href=\"https://app.restockrocket.io\" crossorigin><link rel=\"preconnect\" href=\"https://colourpop-prd.myshopify.com\" crossorigin><!-- Config and setup JS -->\n<script id=\"RestockRocketConfig\">\n  window._RestockRocketConfig = window._RestockRocketConfig || {}\n\n  // Stoq is the current name of the app (RestockRocket is the legacy name).\n  // Expose _Stoq / _StoqConfig as live aliases of the same objects so both names\n  // work. Done here, before the JS bundles run, and the bundles only ever do\n  // `window._RestockRocket = window._RestockRocket || {}` (never reassign), so\n  // every method/config added later is visible on both names.\n  window._RestockRocket = window._RestockRocket || {}\n  window._Stoq = window._RestockRocket\n  window._StoqConfig = window._RestockRocketConfig\n\n  // Earliest nav-relative anchor for the whole pageview: performance.now() when our\n  // inline ran. It's ms-since-navigation for THIS document — unlike liquid_rendered_at,\n  // which on a cached render is the cache time, not this load's start (that gap is\n  // what liquid_cache_age measures). Stamped in the inline (runs on every load, even\n  // when the deferred bundle never does) so bundle_ready's stamps (bundle_loaded_at /\n  // hijack_armed_at) are all on one clock and any delta between them is a plain\n  // subtraction downstream — no need to emit the deltas. See #2875.\n  try { window._RestockRocket.inlineRanAt = performance.now(); } catch (e) { /* no perf API */ }\n\n  // Helper function to normalize locale format from hyphen to underscore (e.g., 'en-US' -> 'en_us')\n  // This matches the backend's Mobility.normalize_locale behavior\n  // Returns empty string if locale is empty or invalid (matches original behavior)\n  function normalizeLocale(locale) {\n    if (!locale || locale.trim() === '') {\n      return '';\n    }\n    return locale.toString().toLowerCase().replace(/-/g, '_');\n  }\n\n  window._RestockRocketConfig.locale = 'en';\n  window._RestockRocketConfig.normalizedLocale = normalizeLocale('en');\n  window._RestockRocketConfig.shop = 'colourpop-prd.myshopify.com';\n  window._RestockRocketConfig.pageType = 'product';\n  window._RestockRocketConfig.liquidRenderedAt = 1785874015;window._RestockRocketConfig.marketId = 6717522;window._RestockRocketConfig.countryName = 'United States';\n    window._RestockRocketConfig.countryIsoCode = 'US';window._RestockRocketConfig.cartInventoryQuantity = {};// cart.token falls back to the `cart` cookie when the Liquid context didn't carry one\n  // (some page types render with cart={} until first interaction).\n  if (!window._RestockRocketConfig.cartToken) {\n    try {\n      const m = document.cookie.match(/(?:^|;\\s*)cart=([^;]+)/);\n      if (m && m[1]) window._RestockRocketConfig.cartToken = decodeURIComponent(m[1]);\n    } catch (e) { /* cookie unavailable */ }\n  }window._RestockRocketConfig.cachedSettings = {\"id\":67987,\"shop_id\":67967,\"currency\":\"USD\",\"created_at\":\"2026-07-17T22:27:52.507Z\",\"updated_at\":\"2026-07-31T22:20:35.719Z\",\"enable_app\":true,\"enable_signup_widget\":false,\"storefront_button_text\":\"Notify me when available\",\"storefront_button_text_color\":\"#FFFFFF\",\"storefront_button_background_color\":\"#202223\",\"storefront_form_header\":\"Notify me\",\"storefront_form_descript