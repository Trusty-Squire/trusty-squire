 e f g h i j k l m n o p q r s t u v w x y z ab ac ae af ag ah ai aj ak\\\" dir=\\\"ltr\\\"\\u003e\\u003cmeta charset=\\\"utf-8\\\"\\u003e \\u003cstrong\\u003eCAFFEINE CONTENT: \\u003c\\/strong\\u003eFlavored Death Wish\\u003cstrong\\u003e \\u003c\\/strong\\u003eCoffee contains approximately 140mg of caffeine based on a 6oz serving following brewing instructions on the package. Learn more about the caffeine content of all Death Wish Coffee products at \\u003ca title=\\\"Learn More About Death Wish Coffee Caffeine Content\\\" href=\\\"https:\\/\\/www.deathwishcoffee.com\\/pages\\/caffeine\\\"\\u003edeathwishcoffee.com\\/caffeine\\u003c\\/a\\u003e.\\u003c\\/span\\u003e\\u003c\\/em\\u003e\\u003c\\/p\\u003e\\n\\u003cp\\u003e\\u003cmeta charset=\\\"utf-8\\\"\\u003e\\u003cstrong\\u003eSUBSCRIBE \\u0026amp; SAVE:\\u003c\\/strong\\u003e Join the Society of Strong Coffee to save 30% off your first shipment and up to 20% off future deliveries. Plus, unlock free shipping on all subscription orders and keep an eye out for exclusive access to upcoming releases.\\u003c\\/p\\u003e\\n\\u003cp\\u003e\\u003cmeta charset=\\\"utf-8\\\"\\u003e\\u003cem\\u003eUnless specified in promotional messaging, coffee subscriptions are not eligible for additional discounts or promotional offers.\\u003c\\/em\\u003e\\u003c\\/p\\u003e\",\"published_at\":\"2023-07-20T09:22:42-04:00\",\"created_at\":\"2023-06-28T12:24:38-04:00\",\"vendor\":\"Death Wish Coffee Company\",\"type\":\"Coffee\",\"tags\":[\"Bagged\",\"Chocolate Hazelnut\",\"Death Wish Coffee\",\"LTO Coffee\",\"Medium Roast\",\"National Coffee Day\",\"Subscription\"],\"price\":1999,\"price_min\":1999,\"price_max\":8499,\"available\":true,\"price_varies\":true,\"compare_at_price\":null,\"compare_at_price_min\":0,\"compare_at_price_max\":0,\"compare_at_price_varies\":false,\"variants\":[{\"id\":40191150096439,\"title\":\"1 bag\",\"option1\":\"1 bag\",\"option2\":null,\"option3\":null,\"sku\":\"LGCHZL14\",\"requires_shipping\":true,\"taxable\":tr