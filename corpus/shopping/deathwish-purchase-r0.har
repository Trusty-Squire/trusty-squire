03,\"position\":5,\"preview_image\":{\"aspect_ratio\":1.0,\"height\":1200,\"width\":1200,\"src\":\"\\/\\/www.deathwishcoffee.com\\/cdn\\/shop\\/files\\/ChocolateHazelnut_Bag.jpg?v=1761682891\"},\"aspect_ratio\":1.0,\"height\":1200,\"media_type\":\"image\",\"src\":\"\\/\\/www.deathwishcoffee.com\\/cdn\\/shop\\/files\\/ChocolateHazelnut_Bag.jpg?v=1761682891\",\"width\":1200}],\"requires_selling_plan\":false,\"selling_plan_groups\":[{\"id\":\"bc6478a662ffae32b3be35b3fe566fa707984433\",\"name\":\"Subscribe and Save\",\"options\":[{\"name\":\"Delivery every\",\"position\":1,\"values\":[\"30 days\",\"60 days\",\"90 days\"]}],\"selling_plans\":[{\"id\":2020048951,\"name\":\"Delivered every 30 days\",\"description\":null,\"options\":[{\"name\":\"Delivery every\",\"position\":1,\"value\":\"30 days\"}],\"recurring_deliveries\":true,\"price_adjustments\":[],\"checkout_charge\":{\"value_type\":\"percentage\",\"value\":100}},{\"id\":2020081719,\"name\":\"Delivered every 60 days\",\"description\":null,\"options\":[{\"name\":\"Delivery every\",\"position\":1,\"value\":\"60 days\"}],\"recurring_deliveries\":true,\"price_adjustments\":[],\"checkout_charge\":{\"value_type\":\"percentage\",\"value\":100}},{\"id\":2020114487,\"name\":\"Delivered every 90 days\",\"description\":null,\"options\":[{\"name\":\"Delivery every\",\"position\":1,\"value\":\"90 days\"}],\"recurring_deliveries\":true,\"price_adjustments\":[],\"checkout_charge\":{\"value_type\":\"percentage\",\"value\":100}}],\"app_id\":\"ordergroove-subscribe-and-save\"}],\"content\":\"\\u003ch4\\u003eAVAILABLE EXCLUSIVELY AT DEATHWISHCOFFEE.COM\\u003c\\/h4\\u003e\\n\\u003cp\\u003ePoised in the perfect purgatory of dark chocolate and heavenly hazelnut, this medium-roasted and full-bodied brew packs the everlasting strength you need with the flavor you crave.\\u003c\\/p\\u003e\\n\\u003cp\\u003eWe worship the ground our goods come from, which means only Fair Trade arabica and robusta beans reach our roasters. Devilishly decadent and never acidic, this fudge-forward flavor tastes like a sin but doesn’t sip like one.\\u003c\\/p\\u003e\\n\\u003cp\\u003e\\u003cmeta charset=\\\"utf-8\\\"\\u003e\\u003cem\\u003e\\u003cspan class=\\\"ui-provider fz b c d e f g h i j k l m n o p q r s t u v w x y z ab ac ae af ag ah ai aj ak\\\" dir=\\\"ltr\\\"\\u003e*Made with natural flavors that have been refined to remove any allergenic protein. Not available in Whole Bean.\\u003c\\/span\\u003e\\u003c\\/em\\u003e\\u003c\\/p\\u003e\\n\\u003cp\\u003e\\u003cem\\u003e\\u003cspan class=\\\"ui-provider fz b c d e f g h i j k l m n o p q r s t u v w x y z ab ac ae af ag ah ai aj ak\\\" dir=\\\"ltr\\\"\\u003e\\u003cmeta charset=\\\"utf-8\\\"\\u003e \\u003cstrong\\u003eCAFFEINE CONTENT: \\u003c\\/strong\\u003eFlavored Death Wish\\u003cstrong\\u003e \\u003c\\/strong\\u003eCoffee contains approximately 140mg of caffeine based on a 6oz serving following brewing instructions on the package. Learn more about the caffeine content of all Death Wish Coffee products at \\u003ca title=\\\"Learn More About Death Wish Coffee Caffeine Content\\\" href=\\\"https:\\/\\/www.deathwishcoffee.com\\/pages\\/caffeine\\\"\\u003edeathwishcoffee.com\\/caffeine\\u003c\\/a\\u003e.\\u003c\\/span\\u003e\\u003c\\/em\\u003e\\u003c\\/p\\u003e\\n\\u003cp\\u003e\\u003cmeta charset=\\\"utf-8\\\"\\u003e\\u003cstrong\\u003eSUBSCRIBE \\u0026amp; SAVE:\\u003c\\/strong\\u003e Join the Society of Strong Coffee to save 30% off your first shipment and up to 20% off future deliveries. Plus, unlock free shipping on all subscription orders and keep an eye out for exclusive access to upcoming releases.\\u003c\\/p\\u003e\\n\\u003cp\\u003e\\u003cmeta charset=\\\"utf-8\\\"\\u003e\\u003cem\\u003eUnless specified in promotional messaging, coffee subscriptions are not eligible for additional discounts or promotional offers.\\u003c\\/em\\u003e\\u003c\\/p\\u003e\"};\n        let mntn_cart_quantity = 0;\n        let mntn_cart_value = \"$0\";\n        let mntn_cart_data = {\"n