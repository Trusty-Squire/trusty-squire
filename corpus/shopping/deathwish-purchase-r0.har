oke=\"#EB001B\" stroke-width=\"0.7\"/>\n          <path d=\"M5.87413 3.52832L5.97439 7.57216H7.02713L7.12739 3.52832H5.87413ZM6.50076 9.66091C6.88091 9.66091 7.18169 9.37267 7.18169 9.00504C7.18169 8.63742 6.88091 8.34917 6.50076 8.34917C6.12061 8.34917 5.81982 8.63742 5.81982 9.00504C5.81982 9.37267 6.12061 9.66091 6.50076 9.66091Z\" fill=\"white\"/>\n          <path d=\"M5.87413 3.17832H5.51535L5.52424 3.537L5.6245 7.58083L5.63296 7.92216H5.97439H7.02713H7.36856L7.37702 7.58083L7.47728 3.537L7.48617 3.17832H7.12739H5.87413ZM6.50076 10.0109C7.06121 10.0109 7.5317 9.57872 7.5317 9.00504C7.5317 8.43137 7.06121 7.99918 6.50076 7.99918C5.94031 7.99918 5.46982 8.43137 5.46982 9.00504C5.46982 9.57872 5.94031 10.0109 6.50076 10.0109Z\" fill=\"white\" stroke=\"#EB001B\" stroke-width=\"0.7\">\n        </svg>\n        <span class=\"product-form__error-message\"></span>\n      </div><form method=\"post\" action=\"/cart/add\" id=\"product-form-template--17259399774263__main\" accept-charset=\"UTF-8\" class=\"form\" enctype=\"multipart/form-data\" novalidate=\"novalidate\" data-type=\"add-to-cart-form\"><input type=\"hidden\" name=\"form_type\" value=\"product\" /><input type=\"hidden\" name=\"utf8\" value=\"✓\" /><input\n          type=\"hidden\"\n          name=\"id\"\n          value=\"40196434001975\"\n          disabled\n          class=\"product-variant-id\"\n        ><div class=\"product-form__buttons\"><button\n            id = \"ProductSubmitButton-template--17259399774263__main\"\n            type=\"submit\"\n            name=\"add\"\n            class=\"product-form__submit button button--full-width button--primary\"\n            \n          >\n            <span>Add to cart\n</span>\n            <div class=\"hidden loading-overlay__spinner\">\n              <svg\n                aria-hidden=\"true\"\n                focusable=\"false\"\n                class=\"spinner\"\n                viewBox=\"0 0 66 66\"\n                xmlns=\"http://www.w3.org/2000/svg\"\n              >\n                <circle class=\"path\" fill=\"none\" stroke-width=\"6\" cx=\"33\" cy=\"33\" r=\"30\"></circle>\n              </svg>\n            </div>\n          </button>\n\n          <div class=\"out-of-stock-form\" style=\"display: none\">\n            <div class=\"klaviyo-form-UDW4Vn\"></div>\n          </div></div><input type=\"hidden\" name=\"product-id\" value=\"6812324921399\" /><input type=\"hidden\" name=\"section-id\" value=\"template--17259399774263__main\" /></form></product-form></div>\n<div id=\"shopify-block-AYTFWcVdqZUtoWSs2R__bnb_app_amazon_buy_now_button_star_rating_h7hYBH\" class=\"shopify-block shopify-app-block\">\n\n\n<!-- Legacy Buy Now Button App Container -->\n<div class=\"buy_now_button_app\"></div>\n\n<!-- V2 Buy Now Button App Container -->\n<div class=\"bnb-buy-now-button\" \n  id=\"bnb-buy-now-button\" \n  data-store-name=\"deathwishcoffee.myshopify.com\"\n  data-bnb-product-id=\"6812324921399\"\n  data-bnb-product-handle=\"chocolate-hazelnut-coffee\"\n  data-cus-id=\"\"\n  data-cus-name=\"\"\n>\n</div>\n\n<script type=\"text/javascript\">\n  \n   async function checkBNBAppVersion(){\n    try {\n        // Checking if the cookie is already set\n        if(getBNBCookie(\"bnb_app_version_deathwishcoffee.myshopify.com\") != null){\n          return getBNBCookie(\"bnb_app_version_deathwishcoffee.myshopify.com\");\n        }\n        // If the cookie is not set, checking the app version from the server\n        const response = await fetch(`https://app.buynowbuttons.com/api/v1/shopify/store/check-app-version?store_name=deathwishcoffee.myshopify.com`);\n        const data = await response.json();\n        if(data.status){\n          if(data.data.app_version == 'legacy'){\n            // Caching the app version\n            setBNBCookie(\"bnb_app_version_deathwishcoffee.myshopify.com\", \"legacy\");\n            return \"legacy\";\n          }else{\n            setBNBCookie(\"bnb_app_version_deathwishcoffee.myshopify.com\", \"v2\");\n            return \"v2\";\n          }\n        }\n      } catch (error) {\n        console.error('Error checking app version:', error);\n        return null;\n      }\n    }\n\n    \n    function setBNBCookie(name, value, minutes = 1440) {\n      const date = new Date();\n      date.setTime(date.getTime() + (minutes * 60 * 1000));\n  \n      document.cookie = `${encodeURIComponent(name)}=${encodeURIComponent(value)}; expires=${date.toUTCString()}; path=/`;\n    }\n\n    \n    function getBNBCookie(name) {\n      const cookies = document.cookie.split(\";\");\n  \n      for (let cookie of cookies) {\n          const [key, value] = cookie.trim().split(\"=\");\n          if (decodeURIComponent(key) === name) {\n              return decodeURIComponent(value);\n          }\n      }\n      return null;\n    }\n\n   \n   (async function(){\n    try {\n      const app_version = await checkBNBAppVersion();\n        // Checking if the app version is legacy\n      if(app_version == 'legacy'){\n        // Updating jquery\n        if ('undefined' == typeof window.jQuery) {\n          var script = document.createElement('script');\n          script.src = 'https://cdn.shopify.com/extensions/019f511a-1c67-7a71-a162-07397e50c10c/bnb-app-11/assets/jquery.min.js';\n          document.getElementsByTagName('head')[0].appendChild(script);\n        }\n\n        // Appending the button loading script\n        let button_loading_script = document.createElement('script');\n        button_loading_script.src = 'https://cdn.shopify.com/extensions/019f511a-1c67-7a71-a162-07397e50c10c/bnb-app-11/assets/buynowbutton.js';\n        button_loading_script.type = 'text/javascript';\n        button_loading_script.defer = true;\n        document.getElementsByTagName('head')[0]?.appendChild(button_loading_script);\n\n        // Updating metafield\n        let metafield = 'true';\n        document.addEventListener('DOMContentLoaded', () => {\n            // Checking if the request is in design mode\n            if (Shopify.designMode === true) {\n                checkForPlan(window.jQuery, shop, Shopify.theme, metafield);\n            }\n        });\n\n        function checkForPlan($, shop) {\n            $.ajax({\n                url: 'https://app.buynowbuttons.com/apps/buynowbutton/check_plan.php',\n                type: \"post\",\n                data: {\n                    store: shop,\n                    theme: Shopify.theme,\n                    metafield: metafield\n                },\n                success: function(e) {\n                    console.log(e);\n                    if (e && e !== \"\") {\n                        if (metafield != e) {\n\n                        }\n                    }\n                },\n                error: function() {}\n            })\n        }\n      }\n\n\n        // Checking if the app version is not legacy\n      if(app_version == 'v2'){\n        // Appending the button loading script\n        window.BNB_V2_BUTTON_SCRIPT_URL = 'https://cdn.shopify.com/extensions/019f511a-1c67-7a71-a162-07397e50c10c/bnb-app-11/assets/script.js';\n        window.BNB_V2_BUTTON_STYLES_URL = 'https://cdn.shopify.com/extensions/019f511a-1c67-7a71-a162-07397e50c10c/bnb-app-11/assets/style.css';\n        let button_loading_script = document.createElement('script');\n        button_loading_script.src = 'https://cdn.shopify.com/extensions/019f511a-1c67-7a71-a162-07397e50c10c/bnb-app-11/assets/init.js';\n        button_loading_script.type = 'text/javascript';\n        button_loading_script.defer = true;\n        document.getElementsByTagName('head')[0]?.appendChild(button_loading_script);\n      }\n    } catch (error) {\n      console.error('Error checking app version:', error);\n    }\n   })();\n</script>\n\n\n\n</div>\n<div class=\"custom-ordergroove-container custom-ordergroove-container--upsell custom-ordergroove-container--bagged\">\n                 <og-offer product=\"40196434001975\"\n                          data-shopify-pro