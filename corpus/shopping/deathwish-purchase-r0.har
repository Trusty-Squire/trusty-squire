l flavored Death Wish Coffee.\"\n    loading=\"lazy\"\n    width=\"1100\"\n    height=\"1100\"\n    data-media-id=\"25939682459703\"\n  ></div>\n  </div>\n</product-modal>\n\n\n  \n<script src=\"//www.deathwishcoffee.com/cdn/shop/t/626/assets/product-modal.js?v=132575917445348640851780427197\" defer=\"defer\"></script>\n    <script src=\"//www.deathwishcoffee.com/cdn/shop/t/626/assets/media-gallery.js?v=123963646055653129181780427197\" defer=\"defer\"></script><script>\n    document.addEventListener('DOMContentLoaded', function () {\n      function isIE() {\n        const ua = window.navigator.userAgent;\n        const msie = ua.indexOf('MSIE ');\n        const trident = ua.indexOf('Trident/');\n\n        return msie > 0 || trident > 0;\n      }\n\n      if (!isIE()) return;\n      const hiddenInput = document.querySelector('#product-form-template--17259399774263__main input[name=\"id\"]');\n      const noScriptInputWrapper = document.createElement('div');\n      const variantSwitcher =\n        document.querySelector('variant-radios[data-section=\"template--17259399774263__main\"]') ||\n        document.querySelector('variant-selects[data-section=\"template--17259399774263__main\"]');\n      noScriptInputWrapper.innerHTML = document.querySelector(\n        '.product-form__noscript-wrapper-template--17259399774263__main'\n      ).textContent;\n      variantSwitcher.outerHTML = noScriptInputWrapper.outerHTML;\n\n      document.querySelector('#Variants-template--17259399774263__main').addEventListener('change', function (event) {\n        hiddenInput.value = event.currentTarget.value;\n      });\n    });\n\n    const scrollIntoViewWithOffset = (selector, offset) => {\n      window.scrollTo({\n        behavior: 'smooth',\n        top:\n                document.querySelector(selector).getBoundingClientRect().top -\n                document.body.getBoundingClientRect().top -\n                offset,\n      })\n    }\n\n    document.querySelectorAll('[data-bv-show=\"rating_summary\"]').forEach(function(element) {\n      element.addEventListener('click', function() {\n        var reviewsSection = document.querySelector('[data-bv-show=\"reviews\"]');\n        var stickyHeader = document.querySelector('sticky-header');\n        if (reviewsSection) {\n          var offset = stickyHeader ? stickyHeader.clientHeight : 0;\n          scrollIntoViewWithOffset('[data-bv-show=\"reviews\"]', offset);\n        }\n      });\n    });\n\n/*\n    var descriptionDiv = document.querySelector('.product__description');\n\n    if (descriptionDiv) {\n      var elementsToClean = descriptionDiv.querySelectorAll('p, h1, h2, h3, h4, h5, h6');\n      descriptionDiv.innerHTML = '';\n      elementsToClean.forEach(function(element) {\n        if (element.tagName === 'P') {\n          var newParagraph = document.createElement('p');\n          var childNodes = element.childNodes;\n          childNodes.forEach(function(node) {\n            if (node.nodeName === 'STRONG') {\n              var newStrongTag = document.createElement('strong');\n              var currentText = node.textContent;\n              var cleanText = currentText.replace(/[^\\x00-\\x7F]+/g, '');\n              newStrongTag.textContent = cleanText;\n              newParagraph.appendChild(newStrongTag);\n            } else if (node.nodeName === 'EM') {\n              var newEmTag = document.createElement('em');\n              var currentText = node.textContent;\n              var cleanText = currentText.replace(/[^\\x00-\\x7F]+/g, '');\n              newEmTag.textContent = cleanText;\n              newParagraph.appendChild(newEmTag);\n            } else if (node.nodeType === 3 || node.nodeName === 'SPAN' || node.nodeName === 'EM' || node.nodeName === 'I') {\n              var currentText = node.textContent;\n              var cleanText = currentText.replace(/[^\\x00-\\x7F]+/g, '');\n              var newTextNode = document.createTextNode(cleanText);\n              newParagraph.appendChild(newTextNode);\n            }\n          });\n          descriptionDiv.appendChild(newParagraph);\n        } else {\n          var currentText = element.textContent;\n          var cleanText = currentText.replace(/[^\\x00-\\x7F]+/g, '');\n          element.textContent = cleanText;\n          descriptionDiv.appendChild(element);\n        }\n      });\n    }\n\n*/\n\n\n  </script><script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org/\",\n  \"@type\": \"Product\",\n  \"@id\": \"https://www.deathwishcoffee.com/products/chocolate-hazelnut-coffee\",\n  \"name\": \"Chocolate Hazelnut Coffee\",\n  \"url\": \"https:\\/\\/www.deathwishcoffee.com\\/products\\/chocolate-hazelnut-coffee\",\n  \"image\": [\n    \"https:\\/\\/www.deathwishcoffee.com\\/cdn\\/shop\\/files\\/Chocolate_Hazelnut_14oz_Ground_Angle_DTC_A2_2.jpg?v=1726759081\\u0026width=1920\"\n  ],\n  \"description\": \"AVAILABLE EXCLUSIVELY AT DEATHWISHCOFFEE.COM\\nPoised in the perfect purgatory of dark chocolate and heavenly hazelnut, this medium-roasted and full-bodied brew packs the everlasting strength you need with the flavor you crave.\\nWe worship the ground our goods come from, which means only Fair Trade arabica and robusta beans reach our roasters. Devilishly decadent and never acidic, this fudge-forward flavor tastes like a sin but doesn’t sip like one.\\n*Made with natural flavors that have been refined to remove any allergenic protein. Not available in Whole Bean.\\n CAFFEINE CONTENT: Flavored Death Wish Coffee contains approximately 140mg of caffeine based on a 6oz serving following brewing instructions on the package. Learn more about the caffeine content of all Death Wish Coffee products at deathwishcoffee.com\\/caffeine.\\nSUBSCRIBE \\u0026amp; SAVE: Join the Society of Strong Coffee to save 30% off your first shipment and up to 20% off future deliveries. Plus, unlock free shipping on all subscription orders and keep an eye out for exclusive access to upcoming releases.\\nUnless specified in promotional messaging, coffee subscriptions are not eligible for additional discounts or promotional offers.\",\n  \"sku\": \"LGCHZL14\",\n  \"brand\": {\n    \"@type\": \"Brand\",\n    \"name\": \"Death Wish Coffee Company\"\n  },\n  \"breadcrumb\": {\n    \"@type\": \"BreadcrumbList\",\n    \"itemListElement\": [\n      {\n        \"@type\": \"ListItem\",\n        \"position\": 1,\n        \"name\": \"Homepage\",\n        \"item\": \"https:\\/\\/www.deathwishcoffee.com\\/\"\n      },{\n        \"@type\": \"ListItem\",\n        \"position\": 2,\n        \"name\": \"Acquisition Landing Page Carousel\",\n        \"item\": \"https:\\/\\/www.deathwishcoffee.com\\/collections\\/acquisition-landing-page-carousel\"\n      },{\n        \"@type\": \"ListItem\",\n        \"position\": 3,\n        \"name\": \"Chocolate Hazelnut Coffee\",\n        \"item\": \"https:\\/\\/www.deathwishcoffee.com\\/products\\/chocolate-hazelnut-coffee\"\n      }\n    ]\n  },\n  \"offers\": [{\n      \"@type\": \"Offer\",\"sku\": \"LGCHZL14\",\"gtin12\": \"810063343248\",\"availability\": \"http://schema.org/InStock\",\n      \"price\": 19.99,\n      \"priceCurrency\": \"USD\",\n      \"url\": \"https:\\/\\/www.deathwishcoffee.com\\/products\\/chocolate-hazelnut-coffee?variant=40191150096439\",\n      \"name\": \"1 bag\"\n    },\n{\n      \"@type\": \"Offer\",\"sku\": \"LGCHZL28\",\"gtin12\": \"810063343248\",\"availability\": \"http://schema.org/InStock\",\n      \"price\": 39.98,\n      \"priceCurrency\": \"USD\",\n      \"url\": \"https:\\/\\/www.deathwishcoffee.com\\/products\\/chocolate-hazelnut-coffee?variant=40196434001975\",\n      \"name\": \"2 bags\"\n    },\n{\n      \"@type\": \"Offer\",\"sku\": \"LGCHZL60\",\"gtin12\": \"810063343248\",\"availability\": \"http://schema.org/InStock\",\n      \"price\": 84.99,\n      \"priceCurrency\": \"USD\",\n      \"url\": \"https:\\/\\/www.deathwishcoffee.com\\/products\\/chocolate-hazelnut-coffee?variant=40196434034743\",\n      \"name\": \"5 bags\"\n    }\n]}\n  </script>\n</section>\n\n</section><div id=\"shopify-section-template--17259399774263__image-with-text\" class=\"shopify-section section\"><link href=\"//www.deathwishcoffee.com/cdn/shop/t/626/assets/component-image-with-text.css?v=5565169357967281221780427197\" rel=\"stylesheet\" type=\"text/css\" media=\"all\" />\n<style data-shopify>\n    .image-with-text[data-section-id=template--17259399774263__image-with-text]{\n      background-color: var(--var-pdp-main-color);\n      color: var(--var-pdp-text-color);\n    }\n    .image-with-text[data-section-id=template--17259399774263__image-with-text] .image-with-text__text-item p{\n      color: var(--var-pdp-text-color) !important;\n    }\n  \n\n  .section-template--17259399774263__image-with-text-padding {\n    padding-top: 0px;\n    padding-bottom: 0px;\n  }\n\n  @media screen and (min-width: 750px) {\n    .section-template--17259399774263__image-with-text-padding {\n      padding-top: 0px;\n      padding-bottom: 0px;\n    }\n  }</style>\n\n<div class='twcss-px-0 image-with-text image-with-text--no-overlap isolate section-template--17259399774263__image-with-text-padding scroll-trigger animate--slide-in' data-section-id=\"template--17259399774263__image-with-text\">\n  <div class='image-with-text__grid grid grid--gapless grid--1-col grid--2-col-tablet image-with-text__grid--reverse'>\n    <div class='image-with-text__media-item image-with-text__media-item--medium image-with-text__media-item--middle grid__item'>\n      <div\n        class='image-with-text__media image-with-text__media--adapt gradient color-background-1 global-media-settings media'\n        \n          style='padding-bottom: 66.66666666666666%;'\n        \n      ><img src=\"//www.deathwishcoffee.com/cdn/shop/files/ChocolateHazelnut-Bagged.jpg?v=1694190631&amp;width=1500\" alt=\"\" srcset=\"//www.deathwishcoffee.com/cdn/shop/files/ChocolateHazelnut-Bagged.jpg?v=1694190631&amp;width=165 165w, //www.deathwishcoffee.com/cdn/shop/files/ChocolateHazelnut-Bagged.jpg?v=1694190631&amp;width=360 360w, //www.deathwishcoffee.com/cdn/shop/files/ChocolateHazelnut-Bagged.jpg?v=1694190631&amp;width=535 535w, //www.deathwishcoffee.com/cdn/shop/files/ChocolateHazelnut-Bagged.jpg?v=1694190631&amp;width=750 750w, //www.deathwishcoffee.com/cdn/shop/files/ChocolateHazelnut-Bagged.jpg?v=1694190631&amp;width=1070 1070w, //www.deathwishcoffee.com/cdn/shop/files/ChocolateHazelnut-Bagged.jpg?v=1694190631&amp;width=1500 1500w\" width=\"1500\" height=\"1000\" loading=\"lazy\" sizes=\"(min-width: 1600px) 750px,\n              (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)\">\n</div>\n    </div>\n    <div class='image-with-text__text-item grid__item'>\n      <div\n        id='ImageWithText--template--17259399774263__image-with-text'\n        class='  twcss-px-[3.2rem]  image-with-text__content image-with-text__content--middle image-with-text__content--desktop-left image-with-text__content--mobile-center image-with-text__content--adapt gradient color-background-1 content-container'\n      >\n          \n          <p\n                class='twcss-uppercase twcss-text-white h1 heading-mob-Small'\n                \n              >\n                DEVILISHLY DECADENT\n              </p>\n\n          \n          <div\n                class='image-with-text__text twcss-mt-6 md:twcss-mt-12 rte'\n                \n              >\n                <div class='body-16'><p><span class=\"metafield-multi_line_text_field\">Death Wish Coffee is made to fuel bold souls—and bold souls deserve high-quality ingredients. We harness the power of naturally high-caffeine robusta beans and blend them with smooth, balanced arabica beans to produce a bold, delicious brew.<br />\n<br />\nDevilishly decadent and never acidic, this fudge-forward flavor tastes like a sin but doesn’t sip like one.</span></p></div>\n              </div>\n</div>\n    </div>\n  </div>\n</div>\n\n\n</div><section id=\"shopify-section-template--17259399