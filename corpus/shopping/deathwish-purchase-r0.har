g?v=1761682891&amp;width=104 104w, //www.deathwishcoffee.com/cdn/shop/files/ChocolateHazelnut_Bag.jpg?v=1761682891&amp;width=162 162w, //www.deathwishcoffee.com/cdn/shop/files/ChocolateHazelnut_Bag.jpg?v=1761682891&amp;width=208 208w, //www.deathwishcoffee.com/cdn/shop/files/ChocolateHazelnut_Bag.jpg?v=1761682891&amp;width=324 324w, //www.deathwishcoffee.com/cdn/shop/files/ChocolateHazelnut_Bag.jpg?v=1761682891&amp;width=416 416w\" width=\"416\" height=\"416\" loading=\"lazy\" sizes=\"(min-width: 1600px) calc((975 - 4rem) / 4),\n          (min-width: 990px) calc((65.0vw - 4rem) / 4),\n          (min-width: 750px) calc((100vw - 15rem) / 8),\n          calc((100vw - 8rem) / 3)\" id=\"Thumbnail-template--17259399774263__main-5\n\">\n                </span>\n                <span\n                  class='md:twcss-hidden slider-counter__link slider-counter__link--dots link'\n                >\n                  <span class='dot'></span>\n                </span>\n              </button>\n            </li></ul>\n    </slider-component></media-gallery>\n    </div>\n    <div class=\"product__info-wrapper  scroll-trigger animate--slide-in\">\n      <product-info\n        id=\"ProductInfo-template--17259399774263__main\"\n        data-section=\"template--17259399774263__main\"\n        data-url=\"/products/chocolate-hazelnut-coffee\"\n        class=\"product__info-container product__column-sticky md:twcss-mt-[64px] lg:twcss-mt-0\"\n      ><div class=\"body-14-bold twcss-hidden md:twcss-inline-block twcss-px-[8px] twcss-pt-[4px] twcss-pb-[6px] twcss-border twcss-mb-[16px]\"></div><div class=\"product__title twcss-hidden md:twcss-block heading-4 !twcss-text-heading-4\" >\n                <h1 class=\"heading-4 !twcss-text-heading-4 twcss-uppercase\" >Chocolate Hazelnut Coffee</h1>\n                <a href=\"/products/chocolate-hazelnut-coffee\" class=\"product__title\">\n                  <h2 class=\"h1\">\n                    Chocolate Hazelnut Coffee\n                  </h2>\n                </a>\n                <div data-bv-show=\"rating_summary\" data-bv-product-id=\"6812324921399\"></div>\n              </div><div class=\"no-js-hidden\" id=\"price-template--17259399774263__main\" role=\"status\" >\n<div\n  class=\"\n    price price--large price--show-badge\"\n>\n  <div class=\"price__container\"><div class=\"price__regular\">\n      <span class=\"visually-hidden visually-hidden--inline\">Regular price</span>\n      <span class=\"price-item price-item--regular\">\n        $19.99\n      </span>\n    </div>\n    <div class=\"price__sale\">\n        <span class=\"visually-hidden visually-hidden--inline\">Regular price</span>\n        <span>\n          <s class=\"price-item price-item--regular\">\n            \n              \n            \n          </s>\n        </span><span class=\"visually-hidden visually-hidden--inline\">Sale price</span>\n      <span class=\"price-item price-item--sale price-item--last\">\n        $19.99\n      </span>\n    </div>\n    <small class=\"unit-price caption hidden\">\n      <span class=\"visually-hidden\">Unit price</span>\n      <span class=\"price-item price-item--last\">\n        <span></span>\n        <span aria-hidden=\"true\">/</span>\n        <span class=\"visually-hidden\">&nbsp;per&nbsp;</span>\n        <span>\n        </span>\n      </span>\n    </small>\n  </div><span class=\"badge price__badge-sale twcss-uppercase !twcss-px-[8px] !twcss-rounded-none !twcss-text-body-14 twcss-font-fenomenBold twcss-font-bold twcss-text-white twcss-border-solid twcss-border-white twcss-bg-transparent\">\n      Sale\n    </span>\n\n    <span class=\"badge price__badge-sold-out twcss-uppercase !twcss-px-[8px] !twcss-rounded-none !twcss-text-body-14 twcss-font-fenomenBold twcss-font-bold twcss-text-white twcss-border-solid twcss-border-white twcss-bg-transparent\">\n      Sold out\n    </span></div>\n</div>\n<div class=\"product__description rte quick-add-hidden body-14\" >\n                  <h4>AVAILABLE EXCLUSIVELY AT DEATHWISHCOFFEE.COM</h4>\n<p>Poised in the perfect purgatory of dark chocolate and heavenly hazelnut, this medium-roasted and full-bodied brew packs the everlasting strength you need with the flavor you crave.</p>\n<p>We worship the ground our goods come from, which means only Fair Trade arabica and robusta beans reach our roasters. Devilishly decadent and never acidic, this fudge-forward flavor tastes like a sin but doesn’t sip like one.</p>\n<p><meta charset=\"utf-8\"><em><span class=\"ui-provider fz b c d e f g h i j k l m n o p q r s t u v w x y z ab ac ae af ag ah ai aj ak\" dir=\"ltr\">*Made with natural flavors that have been refined to remove any allergenic protein. Not available in Whole Bean.</span></em></p>\n<p><em><span class=\"ui-provider fz b c d e f g h i j k l m n o p q r s t u v w x y z ab ac ae af ag ah ai aj ak\" dir=\"ltr\"><meta charset=\"utf-8\"> <strong>CAFFEINE CONTENT: </strong>Flavored Death Wish<strong> </strong>Coffee contains approximately 140mg of caffeine based on a 6oz serving following brewing instructions on the package. Learn more about the caffeine content of all Death Wish Coffee products at <a title=\"Learn More About Death Wish Coffee Caffeine Content\" href=\"https://www.deathwishcoffee.com/pages/caffeine\">deathwishcoffee.com/caffeine</a>.</span></em></p>\n<p><meta charset=\"utf-8\"><strong>SUBSCRIBE &amp; SAVE:</strong> Join the Society of Strong Coffee to save 30% off your first shipment and up to 20% off future deliveries. Plus, unlock free shipping on all subscription orders and keep an eye out for exclusive access to upcoming releases.</p>\n<p><meta charset=\"utf-8\"><em>Unless specified in promotional messaging, coffee subscriptions are not eligible for additional discounts or promotional offers.</em></p>\n                </div>\n<variant-radios\n      id=\"variant-radios-template--17259399774263__main\"\n      class=\"no-js-hidden\"\n      data-section=\"template--17259399774263__main\"\n      data-url=\"/produ