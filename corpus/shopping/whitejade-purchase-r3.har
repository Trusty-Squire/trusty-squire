(--font-body--family);\n    --cart-primary-font-style: var(--font-body--style);\n    --cart-primary-font-weight: var(--font-body--weight);\n    --cart-secondary-font-family: var(--font-secondary--family);\n    --cart-secondary-font-style: var(--font-secondary--style);\n    --cart-secondary-font-weight: var(--font-secondary--weight);\n  }\n</style>\n\n\n<style data-shopify>\n  \n    \n      :root,\n    \n    \n    \n    .color-scheme-1 {\n        --color-background: rgb(255 253 248 / 1.0);\n        /* RGB values only to apply different opacities - Relative color values are not supported in iOS < 16.4 */\n        --color-background-rgb: 255 253 248;\n        --opacity-5-15: 0.05;\n        --opacity-10-25: 0.1;\n        --opacity-35-55: 0.35;\n        --opacity-40-60: 0.4;\n        --opacity-30-60: 0.3;\n        --color-foreground: rgb(75 56 46 / 1.0);\n        --color-foreground-rgb: 75 56 46;\n        --color-foreground-heading: rgb(75 56 46 / 1.0);\n        --color-foreground-heading-rgb: 75 56 46;\n        --color-primary: rgb(75 56 46 / 1.0);\n        --color-primary-rgb: 75 56 46;\n        --color-primary-hover: rgb(106 78 62 / 1.0);\n        --color-primary-hover-rgb: 106 78 62;\n        --color-border: rgb(167 132 84 / 1.0);\n        --color-border-rgb: 167 132 84;\n        --color-shadow: rgb(75 56 46 / 0.15);\n        --color-shadow-rgb: 75 56 46;\n        --color-primary-button-text: rgb(75 56 46 / 1.0);\n        --color-primary-button-background: rgb(216 174 90 / 1.0);\n        --color-primary-button-border: rgb(216 174 90 / 1.0);\n        --color-primary-button-hover-text: rgb(255 244 221 / 1.0);\n        --color-primary-button-hover-background: rgb(75 56 46 / 1.0);\n        --color-primary-button-hover-border: rgb(75 56 46 / 1.0);\n        --color-secondary-button-text: rgb(75 56 46 / 1.0);\n        --color-secondary-button-background: rgb(0 0 0 / 0.0);\n        --color-secondary-button-border: rgb(75 56 46 / 1.0);\n        --color-secondary-button-hover-