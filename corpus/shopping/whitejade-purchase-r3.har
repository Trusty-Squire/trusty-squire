65898351\",\"featured_image\":{\"aspect_ratio\":0.806,\"alt\":\"Red Light Face Mask hero bust\",\"height\":1152,\"url\":\"https:\\/\\/cdn.shopify.com\\/s\\/files\\/1\\/0730\\/5700\\/9775\\/files\\/mask-bust-hero.jpg?v=1783382526\",\"width\":928},\"image\":\"https:\\/\\/cdn.shopify.com\\/s\\/files\\/1\\/0730\\/5700\\/9775\\/files\\/mask-bust-hero.jpg?v=1783382526\",\"handle\":\"red-light-face-mask\",\"requires_shipping\":true,\"product_type\":\"LED Face Mask\",\"product_title\":\"Red Light Face Mask\",\"product_description\":\"A wireless LED face mask emitting red light at 630nm and near-infrared at 850nm.\\nRed light (630nm) is studied for supporting collagen production and evening skin tone. Near-infrared (850nm) reaches deeper, studied to support tissue repair and firmness.\\nSupports\\nFine lines and wrinkles\\nUneven tone and the appearance of dark spots\\nRedness\\nFirmness and elasticity\\n\\nUse10 minutes, three to five times a week, on clean, dry skin.\\nFormat\\nRed 630nm + near-infrared 850nm\\nWireless, rechargeable (3000mAh)\\nFlexible fit, four colours\\n\\nNotesA cosmetic device, not a medical treatment. Avoid if pregnant, photosensitive, or taking photosensitising medication. Results vary. Ships in approximately two weeks. Free shipping, 60-night returns.\",\"variant_title\":\"M500S Blue \\/ China Mainland\",\"variant_options\":[\"M500S Blue\",\"China Mainland\"],\"options_with_values\":[{\"name\":\"Color\",\"value\":\"M500S Blue\"},{\"name\":\"Ships From\",\"value\":\"China Mainland\"}],\"line_level_discount_allocations\":[],\"line_level_total_discount\":0,\"quantity_rule\":{\"min\":1,\"max\":null,\"increment\":1},\"has_components\":false}],\"requires_shipping\":true,\"currency\":\"USD\",\"items_subtotal_price\":10900,\"cart_level_discount_applications\":[],\"discount_codes\":[]}"},"headersSize":0,"bodySize":2603,"redirectURL":"","_transferSize":2603},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":116.749,"receive":2.597},"_wasC