\n      \n      \n        aria-label='slider-arrow'\n      \n      width='14'\n      height='24'\n      viewBox='0 0 14 24'\n      fill='none'\n      xmlns='http://www.w3.org/2000/svg'\n    >\n      <path d=\"M10.6858 1.14712C11.3052 0.51785 12.321 0.521336 12.936 1.15485C13.5287 1.76529 13.5287 2.73627 12.936 3.34672L5.21149 11.3034C4.83482 11.6914 4.83482 12.3086 5.21149 12.6966L12.9359 20.6531C13.5286 21.2636 13.5286 22.2348 12.9359 22.8453C12.3209 23.4788 11.3052 23.4825 10.6856 22.8534L1.38177 13.4069C0.615187 12.6286 0.61498 11.3792 1.3813 10.6006L10.6858 1.14712Z\" fill=\"#283455\"/>\n    </svg></p><div class=\"free__shipping--toggle\"><p class=\"p5\">We offer free ground shipping on all orders over $100 shipping to the contiguous (lower 48) United States. All offered shipping methods and shipping timelines are provided upon checkout.</p></div></div>\n</div><content-drawer\n    role='dialog'\n    aria-modal='true'\n    aria-hidden='true'\n    data-ht-module='cart-drawer'\n    aria-label='cart modal'\n    data-label='cart'\n  >\n    <div class='overlay__modal overlay__modal--cart' data-ht-module='popup-modal' data-bg-color='magic-hour-extralight'>\n      <button class='overlay__modal--close'><svg\n      class='icon icon-close '\n      role='img'\n      \n      \n        aria-label='close'\n      \n      width='8'\n      height='8'\n      viewBox='0 0 8 8'\n      fill='none'\n      xmlns='http://www.w3.org/2000/svg'\n    >\n      <path d=\"M0.464467 7.53553C0.171573 7.24264 0.171573 6.76777 0.464467 6.47487L6.47487 0.464466C6.76777 0.171572 7.24264 0.171572 7.53553 0.464466C7.82843 0.757359 7.82843 1.23223 7.53553 1.52513L1.52513 7.53553C1.23223 7.82843 0.75736 7.82843 0.464467 7.53553Z\" fill=\"#283455\"/><path d=\"M7.53553 7.53553C7.24264 7.82843 6.76777 7.82843 6.47487 7.53553L0.464467 1.52513C0.171573 1.23223 0.171573 0.757359 0.464467 0.464466C0.75736 0.171572 1.23223 0.171572 1.52513 0.464466L7.53553 6.47487C7.82843 6.76777 7.82843 7.24264 7.53553 7.53553