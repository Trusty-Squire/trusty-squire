     \"@context\": \"https://schema.org/\",\n        \"@type\": \"Product\",\n        \"name\": \"Classic Percale Core Sheet Set\",\n        \"description\": \"Rated &quot;Best Sheets&quot; by Wirecutter, our 100% long-staple cotton percale sheets are cool, crisp, and breathable. Includes a fitted sheet, flat sheet, and 2 pillowcases.\",\"sku\": \"COR-T1\",\"productID\": \"7296487424090\",\n        \"url\": \"https://www.brooklinen.com/products/classic-core-sheet-set\",\"image\": \"https://www.brooklinen.com/cdn/shop/files/BKL_25-11_Bedding_Classic_White_CSS_1_x_PDP_WO.jpg?v=1772487751&width=1000\",\"brand\": {\n          \"@type\": \"Brand\",\n          \"name\": \"Brooklinen\"\n        },\n        \"offers\": {\n          \"@type\": \"Offer\",\n          \"url\": \"https://www.brooklinen.com/products/classic-core-sheet-set?variant=41405018112090\",\n          \"priceCurrency\": \"USD\",\n          \"availability\": \"https://schema.org/InStock\",\n          \"itemCondition\": \"https://schema.org/NewCondition\",\n          \"shippingDetails\": {\n            \"@type\": \"OfferShippingDetails\",\n            \"shippingDestination\": {\n              \"@type\": \"DefinedRegion\",\n              \"addressCountry\": \"US\"\n            },\n            \"shippingRate\": {\n              \"@type\": \"MonetaryAmount\",\n              \"value\": \"0.00\",\n              \"currency\": \"USD\"\n            },\n            \"deliveryTime\": {\n              \"@type\": \"ShippingDeliveryTime\",\n              \"transitTime\": {\n                \"@type\": \"QuantitativeValue\",\n                \"minValue\": 1,\n                \"maxValue\": 4,\n                \"unitCode\": \"DAY\"\n              }\n            }\n          },\n          \"hasMerchantReturnPolicy\": {\n            \"@type\": \"MerchantReturnPolicy\",\n            \"applicableCountry\": [ \"US\", \"CA\"],\n            \"returnPolicyCountry\": \"US\",\n            \"returnPolicyCategory\": \"https://schema.org/MerchantReturnFiniteReturnWindow\",\n            \"merchantReturnDays\": 365,\n            \"itemCondition\": \"https://schema.org/NewCondition\",\n            \"returnMethod\": \"https://schema.org/ReturnByMail\",\n            \"returnFees\": \"https://schema.org/ReturnShippingFees\",\n            \"refundType\": \"https://schema.org/FullRefund\",\n            \"returnShippingFeesAmount\": {\n              \"@type\": \"MonetaryAmount\",\n              \"value\": 9.95,\n              \"currency\": \"USD\"\n            },\n            \"returnLabelSource\": \"https://schema.org/ReturnLabelDownloadAndPrint\"\n          }\n        }\n      }\n\n      brooklinenData = {\n        \"isBundle\": false,\n        \"isLastCall\": false,\n        \"isComparePrice\": false,\n        \"isCategoryPromo\": false,\n        \"discountEligibile\": true,\n        \"tags\": \"Active Classic,Active PLP,backtocampus,Best of Brooklinen Bundle,Classic Bed and Bath Bundle,Classic Percale & Washed European Linen Hardcore Bundle,Classic Percale Cozy Ribbed Hardcore Bundle,Classic Percale Dreamweave Hardcore Bundle,Classic Percale Dreamweave Starter Bundle,Classic Percale Dreamweave Starter Bundle Exclusive,Classic Percale Hardcore Sheet Bundle,Classic Percale Hardcore Sheet Bundle New,Classic Percale Lightweight Hardcore Bundle,Classic Percale Lightweight Starter Bundle,Classic Percale Ribbed Matelasse Hardcore Bundle,Classic Percale Ribbed Matelasse Starter Bundle,Classic Percale Woven Checkerboard Hardcore Bundle,Classic Sheets,Compare Module Slider,Discount Codes: Allow,DY Category 1: Bedding,DY Category 2: Sheets,DY Category 3: Classic Sheets,DY Feed,Evergreen: 16,feedonomics-include,Holiday Gift Guide,Marketing: Icon,newarrivals,Parent Sku,PDP Gallery Option: Color,PDP Modal Option: oeko,PDP Modal Option: Packs,PDP Modal Option: Size,Product Feed,Retail Bundle Products,Retail Single Products,Review Product: classic-core-sheet-set-2,Review ProductID: 7579265926,Romance Description,Set of 2 Classic Percale Core Sheet Set Bundle,Sku Expansion,Slashouts: Default,The Anniversary Bundle,Yotpo Points\"};\n\n        resolve(structuredData);\n      })\n     }\n  \n  // Utility Functions \n  const hasDiscountTag = (shopifyTags, dyTag) => shopifyTags.includes(dyTag)\n  const formatsPrice = (price) => parseFloat(price).toFixed(2);\n  \n  async function fetchStructuredData() {\n    try {\n\n      const liquidCreatedData = await liquidSd();\n\n      const { isBundle, isLastCall, isCategoryPromo, bundleDiscountPrice, categoryBundlePrice, isComparePrice } = brooklinenData\n      const { amount, tags, allAudiences, enabled } = window.Brooklinen?.promo?.discounts?.swd ?? {};\n\n      structuredData.offers.price = formatsPrice(159.0);\n      let{ price } = structuredData.offers;\n\n      const googleShopping = window.location.href.includes('/collections/gs');\n     // Checks for tags in DY tag field that is coming from Promo obj\n      const shopifyTags = brooklinenData.tags.split(',');\n      const sitewideDiscount = hasDiscountTag(shopifyTags, tags) && enabled && allAudiences;\n      const prospectDiscount = !allAudiences && hasDiscountTag(shopifyTags, tags) && enabled;\n      const noDiscount = !enabled;\n\n     // Sitewide discount for all audiences \n        let discountedPrice;\n        let percentageBasedDiscount = (1 - (amount / 100));\n\n  // If price is 0 default to the current variant price from Shopify, \n// Doing this as a precaution so the price is never not 0 in case from price metafields arent set\n  if (parseFloat(price) === 0) {\n    price = formatsPrice(159.0);\n  }\n  // Handles sale price property in structured data\n        switch(true) {\n          case (prospectDiscount && isBundle && !googleShopping):\n           // Default from price with Prospect + Bundle + Not collection/gs\n            discountedPrice = formatsPrice(bundleDiscountPrice * percentageBasedDiscount);\n            break;\n          case (prospectDiscount && isBundle):\n           // Default from price with Prospect + Bundle\n            discountedPrice = formatsPrice(bundleDiscountPrice);\n            break;\n          case (sitewideDiscount && isBundle):\n          // SWD + Bundle \n            discountedPrice = formatsPrice(bundleDiscountPrice * percentageBasedDiscount);\n            break;\n          case (isCategoryPromo && isBundle):\n          // Category Promo + Bundle\n            discountedPrice = formatsPrice(categoryBundlePrice);\n            break;\n          case (isBundle):\n            discountedPrice = formatsPrice(bundleDiscountPrice);\n            break;\n          case (isCategoryPromo):\n            discountedPrice = formatsPrice(0);\n            break;\n          case (sitewideDiscount && !prospectDiscount):\n          // SWD Discount All Audiences \n            discountedPrice = formatsPrice(price * percentageBasedDiscount);\n            break;\n          case (isBundle && noDiscount):\n            // Bundle with no bundle discount\n            discountedPrice = formatsPrice(bundleDiscountPrice);\n            if (isCategoryPromo) {\n              discountedPrice = formatsPrice(categoryBundlePrice);\n            }\n            break;\n          case (isBundle && sitewideDiscount):\n            discountedPrice = formatsPrice(bundleDiscountPrice * percentageBasedDiscount);\n            break;\n          case(isComparePrice || isLastCall || isCategoryPromo):\n            discountedPrice = formatsPrice(0);\n            break;\n          case (amount < 100 && !prospectDiscount && enabled):\n            discountedPrice = formatsPrice(price * percentageBasedDiscount);\n            break;\n          case (prospectDiscount && !isBundle && !googleShopping):\n          // In this use case we have to apply the prospect discount directly to the price field,\n          //to follow the rules of never being on sale all the time\n            price = formatsPrice(price * percentageBasedDiscount);\n            break;\n          default:\n            discountedPrice = null;\n            break;\n        }\n\n        // Only add sale price schema for sitewide discounts or category promos —\n        // compare-at price and last call markdowns should not reflect as a slashout in structured data\n        const shouldAddSalePrice = sitewideDiscount || isCategoryPromo;\n\n        if (shouldAddSalePrice && discountedPrice && parseFloat(discountedPrice) < parseFloat(price)) {\n          delete structuredData.offers.price;\n          structuredData.offers.priceSpecification = [\n            {\n              \"@type\": \"UnitPriceSpecification\",\n              \"priceType\": \"https://schema.org/SalePrice\",\n              \"price\": discountedPrice,\n              \"priceCurrency\": structuredData.offers.priceCurrency\n            },\n            {\n              \"@type\": \"UnitPriceSpecification\",\n              \"priceType\": \"https://schema.org/ListPrice\",\n              \"price\": price,\n              \"priceCurrency\": structuredData.offers.priceCurrency\n            }\n          ];\n        } else {\n          structuredData.offers.price = price;\n        }\n\n      return liquidCreatedData;\n    }\n    catch(error) {\n      console.error(`Could not get structured data: ${error}`);\n    }\n  }\n  \n  // Creates and appends script tag with structured data to DOM\n  let createJsonLdScript = (data) => {\n    let jsonldScript = document.createElement('script');\n    jsonldScript.id = 'productData';\n    jsonldScript.setAttribute('type','application/ld+json');\n    jsonldScript.textContent = JSON.stringify(data);\n  \n    // Remove server side set product data if present\n    let ssElm = document.getElementById('ssProductData');\n    if(ssElm) ssElm.remove();\n    document.head.appendChild(jsonldScript);\n  }\n  \n  document.addEventListener(\"dy:promo:ready\", () => {\n    const sdPromise = fetchStructuredData();\n    sdPromise.then((data) => {\n        console.log('[json-ld] final structured data injected:', data);\n        createJsonLdScript(data);\n    });\n  }, { once: true });\n  </script>\n\n</div><section id=\"shopify-section-template--21349961760858__main_product_modals_e8QdEU\" class=\"shopify-section section\">\n<content-drawer\n    role='dialog'\n    aria-modal='true'\n    aria-hidden='true'\n    aria-label='size guide modal'\n    data-label='size-classic-core-sheet-set'\n  >\n    <div class='overlay__modal' data-ht-module='popup-modal' data-bg-color='magic-hour-extralight'>\n      <button class='btn overlay__modal--close'><svg\n      class='icon icon-close '\n      role='img'\n      \n      \n        aria-label='close'\n      \n      width='8'\n      height='8'\n      viewBox='0 0 8 8'\n      fill='none'\n      xmlns='http://www.w3.org/2000/svg'\n    >\n      <path d=\"M0.464467 7.53553C0.171573 7.24264 0.171573 6.76777 0.464467 6.47487L6.47487 0.464466C6.76777 0.171572 7.24264 0.171572 7.53553 0.464466C7.82843 0.757359 7.82843 1.23223 7.53553 1.52513L1.52513 7.53553C1.23223 7.82843 0.75736 7.82843 0.464467 7.53553Z\" fill=\"#283455\"/><path d=\"M7.53553 7.53553C7.24264 7.82843 6.76777 7.82843 6.47487 7.53553L0.464467 1.52513C0.171573 1.23223 0.171573 0.757359 0.464467 0.464466C0.75736 0.171572 1.23223 0.171572 1.52513 0.464466L7.53553 6.47487C7.82843 6.76777 7.82843 7.24264 7.53553 7.53553Z\" fill=\"#283455\"/>\n    </svg></button>\n      <div class='overlay__modal--content'><div class='size-guide__container' data-color='night-sky-dark'>\n    \n    \n      <h2 class='h2 '>Size Guide</h2>\n    \n\n    \n<div class=\"size-guide__subcopy p4\"><p>Our Fitted Sheets are designed to fit mattresses up to 16&quot; deep, with 12&quot;-16&quot; being the best fit.</p></div>\n\n<div class='size-guide__wrapper' data-bg-color='magic-hour-light'>\n      <div class='js-measure size-guide__table' data-enable='true'>\n        \n          \n          \n          <div\n            class='js-size-guide'\n            data-type=''\n            data-enable='true'\n    