=\"splide__track\">\n            <ul class=\"splide__list\"><li class=\"splide__slide offer\" >\n                    <div class=\"slide--text\" data-slide=\"1\">\n                      <span class=\"t5 text\">\n                        \n<a href=\"https://www.brooklinen.com/pages/all-bath\" title=\"https://www.brooklinen.com/pages/all-bath\">Splash Sale: 20% off all bath starts now.</a>\n                      </span><a\n                        class=\"p5 terms terms--link\"\n                        data-ht-element=\"cta\"\n                        data-color=\"white\"\n                        data-type=\"modal\" for=\"static-nano\"\n                        href=\"#\">\n                        Terms apply.\n                      </a>\n                    </div>\n                  </li><li class=\"splide__slide offer\" >\n                    <div class=\"slide--text\" data-slide=\"2\">\n                      <span class=\"t5 text\">\n                        \nOur coolest bedding, designed for when things heat up. <a href=\"https://www.brooklinen.com/pages/cooling-shop\" title=\"https://www.brooklinen.com/pages/cooling-shop\">Shop now.</a>\n                      </span>\n                    </div>\n                  </li><li class=\"splide__slide offer\" >\n                    <div class=\"slide--text\" data-slide=\"3\">\n                      <span class=\"t5 text\">\n                        \nFast, free shipping on orders $100 or more.\n                      </span>\n                    </div>\n                  </li></ul>\n          </div>\n        </div>\n      </div></div><content-drawer\n        role=\"dialog\"\n        aria-modal=\"true\"\n        aria-hidden=\"true\"\n        aria-label=\"nanobar terms modal\"\n        data-label=\"static-nano\">\n        <div class=\"overlay__modal\" data-ht-module=\"popup-modal\" data-bg-color=\"magic-hour-extralight\">\n          <button class=\"btn overlay__modal--close\"><svg\n      class='icon icon-close '\n      role='img'