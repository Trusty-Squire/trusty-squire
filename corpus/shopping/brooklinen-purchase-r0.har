 bundle.&quot;}, &quot;unavailable&quot;=&gt;{&quot;main&quot;=&gt;&quot;This bundle is sold out&quot;, &quot;sub&quot;=&gt;&quot;Select a different size or color above.&quot;}, &quot;component&quot;=&gt;{&quot;oos&quot;=&gt;&quot;This product is sold out, but you can&quot;, &quot;edit&quot;=&gt;&quot;choose a different color.&quot;}}, &quot;back_in_stock&quot;=&gt;{&quot;atc&quot;=&gt;&quot;Sold Out &mdash; Join Waitlist&quot;, &quot;atc_sub&quot;=&gt;&quot;&quot;, &quot;modal&quot;=&gt;{&quot;header&quot;=&gt;&quot;Join Waitlist&quot;, &quot;caption&quot;=&gt;&quot;We’ll notify you when this product is back in stock.&quot;, &quot;email_placeholder&quot;=&gt;&quot;Email&quot;, &quot;error&quot;=&gt;&quot;Please enter a valid email address.&quot;, &quot;legal&quot;=&gt;&quot;By signing up, you are agreeing to receive marketing and promotional emails related to Brooklinen. If you do not wish to receive email correspondence, you can opt out at any time by unsubscribing&quot;, &quot;cta&quot;=&gt;&quot;Submit&quot;, &quot;success&quot;=&gt;&quot;Added to waitlist!&quot;}}}'\n    \n      props-selection-listener\n    \n  ></div>\n</product-slider>\n</section><section id=\"shopify-section-template--21349961760858__spotlight_LrC7mD\" class=\"shopify-section section-spotlight stepped--hide\">\n\n\n</section><div id=\"shopify-section-template--21349961760858__reviews\" class=\"shopify-section\"><div class='page-width reviews' id=\"ReviewsWidget\">\n  <div\n    class='yotpo-widget-instance'\n    data-yotpo-instance-id='472038'\n    data-yotpo-product-id='7579265926'\n    data-yotpo-name='Classic Percale Core Sheet Set'\n    data-yotpo-url='https://www.brooklinen.com/products/classic-core-sheet-set'\n    data-yotpo-image-url='https://www.brooklinen.com/cdn/shop/files/BKL_25-11_Bedding_Classic_White_CSS_1_x_PDP_WO_large.jpg%3Fv=1772487751'\n    data-yotpo-price='159.0'\n    data-yotpo-currency='USD'\n    data-yotpo-description='&lt;p&gt;Hotel-sheet lovers, these are your sheets. Cool, crisp, and ideal for hot sleepers. This the fabric that put us on the map. Our Classic Percale sheets start with the highest quality threads, using 270 thread count long-staple cotton with a one-yarn-over and one-yarn-under weave. This results in a matte finish for that breathable, hotel-style feel. Its exceptional softness and durability means it gets better with every wash, without pilling. Its lightweight, matte finish makes it the top choice for warmer climates, and year-round hot sleepers (night-sweaters this fabric is for you!)&lt;/p&gt;\n&lt;ul&gt;\n&lt;li&gt;OEKO-TEX certified for chemical safety&lt;/li&gt;\n&lt;li&gt;Keep your pillows secure with our pillowcase envelope closures&lt;/li&gt;\n&lt;li&gt;No sweat bed-making with Long and Short side tags on our fitted sheets&lt;/li&gt;\n&lt;li&gt;Colors and patterns to fit your taste, no matter your aesthetic&lt;/li&gt;\n&lt;li&gt;Core Sheet Set includes: flat sheet, fitted sheet, and 2 pillowcases&lt;/li&gt;\n&lt;li&gt;&lt;span style=&quot;font-family: -apple-system, BlinkMacSystemFont, &#39;San Francisco&#39;, &#39;Segoe UI&#39;, Roboto, &#39;Helvetica Neue&#39;, sans-serif; font-size: 0.875rem;&quot;&gt; Twin and Twin XL sets include 1 pillowcase&lt;/span&gt;&lt;/li&gt;\n&lt;li&gt;&lt;span style=&quot;font-family: -apple-system, BlinkMacSystemFont, &#39;San Francisco&#39;, &#39;Segoe UI&#39;, Roboto, &#39;Helvetica Neue&#39;, sans-serif; font-size: 0.875rem;&quot;&gt;King/Cali King sets come with king sized pillowcases&lt;/span&gt;&lt;/li&gt;\n&lt;/ul&gt;'\n    data-ht-module=\"pdp-reviews\"\n    id=\"pdpReview\"\n  ></div>\n</div>\n</div><section id=\"shopify-section-template--21349961760858__social_RYxmC9\" class=\"shopify-section section section-social stepped--hide\">\n  <div\n    class='slider-module module--stacking social__carousel'\n    data-bg-color='magic-hour-medium'\n    data-ht-module='social'\n    data-color='night-sky-dark'\n    id='Bedding Social Slider'\n  >\n    <div class='js-splid