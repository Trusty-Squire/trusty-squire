:1.0,\"height\":2048,\"width\":2048,\"src\":\"\\/\\/www.brooklinen.com\\/cdn\\/shop\\/files\\/BKL_26-05_Bedding_Bundle_Classic_Dandelions_WarmTerracotta_HCB_1x_PDP_WO-2_1_d59f2e56-7fa2-454e-8274-74ccec6d6e78.jpg?v=1784044329\"},\"aspect_ratio\":1.0,\"height\":2048,\"media_type\":\"image\",\"src\":\"\\/\\/www.brooklinen.com\\/cdn\\/shop\\/files\\/BKL_26-05_Bedding_Bundle_Classic_Dandelions_WarmTerracotta_HCB_1x_PDP_WO-2_1_d59f2e56-7fa2-454e-8274-74ccec6d6e78.jpg?v=1784044329\",\"width\":2048}],\"requires_selling_plan\":false,\"selling_plan_groups\":[],\"content\":\"\\u003cp\\u003eHotel-sheet lovers, these are your sheets. Cool, crisp, and ideal for hot sleepers. This the fabric that put us on the map. Our Classic Percale sheets start with the highest quality threads, using 270 thread count long-staple cotton with a one-yarn-over and one-yarn-under weave. This results in a matte finish for that breathable, hotel-style feel. Its exceptional softness and durability means it gets better with every wash, without pilling. Its lightweight, matte finish makes it the top choice for warmer climates, and year-round hot sleepers (night-sweaters this fabric is for you!)\\u003c\\/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003eOEKO-TEX certified for chemical safety\\u003c\\/li\\u003e\\n\\u003cli\\u003eKeep your pillows secure with our pillowcase envelope closures\\u003c\\/li\\u003e\\n\\u003cli\\u003eNo sweat bed-making with Long and Short side tags on our fitted sheets\\u003c\\/li\\u003e\\n\\u003cli\\u003eColors and patterns to fit your taste, no matter your aesthetic\\u003c\\/li\\u003e\\n\\u003cli\\u003eCore Sheet Set includes: flat sheet, fitted sheet, and 2 pillowcases\\u003c\\/li\\u003e\\n\\u003cli\\u003e\\u003cspan style=\\\"font-family: -apple-system, BlinkMacSystemFont, 'San Francisco', 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif; font-size: 0.875rem;\\\"\\u003e Twin and Twin XL sets include 1 pillowcase\\u003c\\/span\\u003e\\u003c\\/li\\u003e\\n\\u003cli\\u003e\\u003cspan style=\\\"font-family: -apple-system, BlinkMacSystemFont, 'San Francisco', 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif; font-size: 0.875rem;\\\"\\u003eKing\\/Cali King sets come with king sized pillowcases\\u003c\\/span\\u003e\\u003c\\/li\\u003e\\n\\u003c\\/ul\\u003e\"};\n      window.SwymProductInfo.variants = window.SwymProductInfo.product.variants;\n      var piu = \"\\/\\/www.brooklinen.com\\/cdn\\/shop\\/files\\/BKL_25-11_Bedding_Classic_White_CSS_1_x_PDP_WO.jpg?crop=center\\u0026height=620\\u0026v=1772487751\\u0026width=620\";\n      \n\n        SwymProductVariants[41405018112090] = {\n          empi: window.SwymProductInfo.product.id,epi:41405018112090,\n          dt: \"Classic Percale Core Sheet Set\",\n          du: \"https://www.brooklinen.com/products/classic-core-sheet-set\",\n          iu:  \"\\/\\/www.brooklinen.com\\/cdn\\/shop\\/files\\/BKL_25-11_Bedding_Classic_White_CSS_1_x_PDP_WO.jpg?crop=center\\u0026height=620\\u0026v=1772487751\\u0026width=620\" ,\n          stk:  1 ,\n          pr: 15900/100,\n          ct: window.SwymProductInfo.product.type,\n          \n          variants: [{ \"Solid White \\/ Twin\" : 41405018112090}]\n        };\n        SwymProductVariants[41405018603610] = {\n          empi: window.SwymProductInfo.product.id,epi:41405018603610,\n          dt: \"Classic Percale Core Sheet Set\",\n          du: \"https://www.brooklinen.com/products/classic-core-sheet-set\",\n          iu:  \"\\/\\/www.brooklinen.com\\/cdn\\/shop\\/files\\/BKL_25-11_Bedding_Classic_White_CSS_1_x_PDP_WO.jpg?crop=center\\u0026height=620\\u0026v=1772487751\\u0026width=620\" ,\n          stk:  1 ,\n          pr: 15900/100,\n          ct: window.SwymProductInfo.product.type,\n          \n          variants: [{ \"Solid White \\/ Twin XL\" : 41405018603610}]\n        };\n        SwymProductVariants[41405019095130] = {\n          empi: window.SwymProductInfo.product.id,epi:41405019095130,\n          dt: \"Classic Percale Core Sheet Set\",\n          du: \"