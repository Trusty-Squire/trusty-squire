r\"/>\n    </g>\n    <g style=\"--index: 6;\">\n      <line class=\"line\" stroke-linecap=\"round\" pathLength=\"1\" x1=\"12\" y1=\"8.5\" x2=\"12\" y2=\"15.5\" stroke=\"currentColor\"/>\n    </g>\n    <g style=\"--index: 7;\">\n      <line class=\"line\" stroke-linecap=\"round\" pathLength=\"1\" x1=\"12\" y1=\"8.5\" x2=\"12\" y2=\"15.5\" stroke=\"currentColor\"/>\n    </g>\n  </g>\n</svg>\n</span>\n    </span>\n  </button>\n</add-to-cart-component>\n\n</span>\n\n\n\n\n          \n\n\n\n\n\n  <div\n    class=\"accelerated-checkout-block\"\n    ref=\"acceleratedCheckoutButtonContainer\"\n    \n    \n    \n  >\n    \n  \n    <div data-shopify=\"payment-button\" class=\"shopify-payment-button\"> <shopify-accelerated-checkout recommended=\"{&quot;supports_subs&quot;:true,&quot;supports_def_opts&quot;:false,&quot;name&quot;:&quot;shop_pay&quot;,&quot;wallet_params&quot;:{&quot;shopId&quot;:73057009775,&quot;merchantName&quot;:&quot;White Jade&quot;,&quot;personalized&quot;:true}}\" fallback=\"{&quot;supports_subs&quot;:true,&quot;supports_def_opts&quot;:true,&quot;name&quot;:&quot;buy_it_now&quot;,&quot;wallet_params&quot;:{}}\" access-token=\"394b472404d8dc6a7efdb1c410786627\" buyer-country=\"US\" buyer-locale=\"en\" buyer-currency=\"USD\" variant-params=\"[{&quot;id&quot;:53575613546607,&quot;requiresShipping&quot;:true}]\" shop-id=\"73057009775\" enabled-flags=\"[&quot;a1d1f9a1&quot;]\" > <div class=\"shopify-payment-button__button\" role=\"button\" disabled aria-hidden=\"true\" style=\"background-color: transparent; border: none\"> <div class=\"shopify-payment-button__skeleton\">&nbsp;</div> </div> <div class=\"shopify-payment-button__more-options shopify-payment-button__skeleton\" role=\"button\" disabled aria-hidden=\"true\">&nbsp;</div> </shopify-accelerated-checkout> <small id=\"shopify-buyer-consent\" class=\"hidden\" aria-hidden=\"true\" data-consent-type=\"subscription\"> This item is a deferred, subscription, or recurring purchase. By continuing, I agree to the <span id=\"shopify-subscription-policy-button\">cancellation policy</span> and authorize you to charge my payment method at the prices, frequency and dates listed on this page until my order is fulfilled or I cancel, if permitted. </small> </div>\n  \n\n  </div>\n\n\n\n\n\n\n\n        </div><input type=\"hidden\" name=\"product-id\" value=\"15187410616431\" /><input type=\"hidden\" name=\"section-id\" value=\"template--26292851048559__main\" /></form></product-form-component></span>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  <rte-formatter class=\" spacing-style text-block text-block--AdnBwNCtqQVBSdWIyR__text_aEtTtq rte    text-block--align-left rte   \"  style=\"    --padding-block-start: 0px; --padding-block-end:0px; --padding-inline-start:0px; --padding-inline-end:0px;         --width: 100%;    --max-width: var(--max-width--body-normal);          --text-align: left;          \">\n    <p>A concentrated PDRN and collagen ampoule serum with peptides — the step between light and crème.</p>\n<p>Polynucleotides (PDRN) and hydrolysed collagen support repair and elasticity; peptides and hyaluronic acid plump and hydrate. Lightweight and fast-absorbing, it layers cleanly under moisturiser.</p>\n<h3>Supports</h3><ul>\n<li>Fine lines and loss of firmness</li>\n<li>Dullness and uneven texture</li>\n<li>Hydration and bounce</li>\n</ul>\n<h3>Use</h3><p>After cleansing and any light therapy, press a few drops into clean skin. Follow with The Recovery Crème. Morning and night.</p>\n<h3>Notes</h3><p>For external cosmetic use. Patch test first. Free shipping, 60-night returns.</p>\n  </rte-formatter>\n\n\n\n\n\n\n<div id=\"shopify-block-AU25SdVc4ZTFaWXpxS__judgeme_review_widget\" class=\"shopify-block shopify-app-block\">\n\n\n<div style='clear:both'></div>\n<div id='judgeme_product_reviews'\n    class='jdgm-widget jdgm-review-widget'\n    data-product-title='The Glow Serum'\n    data-id='15187410616431'\n    data-product-id='15187410616431'\n    data-widget=\"review\"\n    data-shop-reviews=\"false\"\n    data-shop-reviews-count=\"0\"\n    data-cart-eligible-template=\"false\"\n    data-shop-average-rating=\"4.96\"\n    data-shop-review-count=\"56\"\n    data-empty-state=\"empty_widget\"\n    data-entry-point=\"review_widget.js\"\n    data-entry-key=\"review-widget/main.js\"\n    data-block-id=\"AU25SdVc4ZTFaWXpxS__judgeme_review_widget\"\n    data-customer-logged-in=\"false\"\n    \n    \n    style='max-width: 1200px; margin: 0 auto;'>\n\n  \n    \n      <div class='jdgm-legacy-widget-content' style='display: none;'>\n        <div class='jdgm-rev-widg' data-updated-at='2026-07-05T02:48:52Z' data-average-rating='5.00' data-number-of-reviews='12' data-number-of-questions='0' data-image-url='https://cdn.shopify.com/s/files/1/0730/5700/9775/files/wj-serum.jpg?v=1783219163'> <style class='jdgm-temp-hiding-style'>.jdgm-rev-widg{ display: none }</style> <div class='jdgm-rev-widg__header'> <h2 class='jdgm-rev-widg__title'>Customer Reviews</h2>  <div class='jdgm-rev-widg__summary'> <div class='jdgm-rev-widg__summary-stars' aria-label='Average rating is 5.00 stars' role='img'> <span class='jdgm-star jdgm--on'></span><span class='jdgm-star jdgm--on'></span><span class='jdgm-star jdgm--on'></span><span class='jdgm-star jdgm--on'></span><span class='jdgm-star jdgm--on'></span> </div> <div class='jdgm-rev-widg__summary-text'>Based on 12 reviews</div> </div> <a style='display: none' href='#' class='jdgm-write-rev-link' role='button'>Write a review</a> <div class='jdgm-histogram jdgm-temp-hidden'>  <div class='jdgm-histogram__row' data-rating='5' data-frequency='12' data-percentage='100'>  <div class='jdgm-histogram__star' role='button' aria-label=\"100% (12) reviews with 5 star rating\"  tabindex='0' ><span class='jdgm-star jdgm--on'></span><span class='jdgm-star jdgm--on'></span><span class='jdgm-star jdgm--on'></span><span class='jdgm-star jdgm--on'></span><span class='jdgm-star jdgm--on'></span></div> <div class='jdgm-histogram__bar'> <div class='jdgm-histo