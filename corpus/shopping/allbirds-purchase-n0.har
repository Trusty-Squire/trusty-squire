ax-md:overflow-hidden max-md:px-3 md:w-auto md:overflow-visible'>\n          <div\n            role='tablist'\n            aria-label='Product view'\n            class='flex overflow-x-auto rounded-full border border-black p-0.5 [scrollbar-width:none] md:overflow-hidden [&::-webkit-scrollbar]:hidden'\n          ><button\n                role='tab'\n                :aria-selected=\"activeView === 'side'\"\n                class='h-[26px] flex-1 shrink-0 cursor-pointer rounded-full px-4 text-xs font-medium tracking-wider uppercase transition-colors data-[active=false]:hover:bg-black/5 md:flex-none'\n                :class=\"activeView === 'side' ? 'bg-black text-white' : 'text-black'\"\n                :data-active=\"activeView === 'side'\"\n                @click=\"setView('side')\"\n              >\n                SIDE\n              </button><button\n                role='tab'\n                :aria-selected=\"activeView === 'top'\"\n                class='h-[26px] flex-1 shrink-0 cursor-pointer rounded-full px-4 text-xs font-medium tracking-wider uppercase transition-colors data-[active=false]:hover:bg-black/5 md:flex-none'\n                :class=\"activeView === 'top' ? 'bg-black text-white' : 'text-black'\"\n                :data-active=\"activeView === 'top'\"\n                @click=\"setView('top')\"\n              >\n                TOP\n              </button><button\n                role='tab'\n                :aria-selected=\"activeView === 'back'\"\n                class='h-[26px] flex-1 shrink-0 cursor-pointer rounded-full px-4 text-xs font-medium tracking-wider uppercase transition-colors data-[active=false]:hover:bg-black/5 md:flex-none'\n                :class=\"activeView === 'back' ? 'bg-black text-white' : 'text-black'\"\n                :data-active=\"activeView === 'back'\"\n                @click=\"setView('back')\"\n              >\n                BACK\n              </button><button\n                role='tab'\n                :aria-selected=\"activeView === 'sole'\"\n                class='h-[26px] flex-1 shrink-0 cursor-pointer rounded-full px-4 text-xs font-medium tracking-wider uppercase transition-colors data-[active=false]:hover:bg-black/5 md:flex-none'\n                :class=\"activeView === 'sole' ? 'bg-black text-white' : 'text-black'\"\n                :data-active=\"activeView === 'sole'\"\n                @click=\"setView('sole')\"\n              >\n                SOLE\n              </button></div>\n          <div\n            v-show='viewsTabsOverflow'\n            class='from-natural-white-60 pointer-events-none absolute top-0 right-0 bottom-0 z-10 w-16 bg-gradient-to-l to-transparent md:hidden'\n          ></div>\n        </div>\n        <button\n          class='hidden size-8 shrink-0 cursor-pointer items-center justify-center md:flex'\n          @click='nextView'\n          aria-label='Next view'\n        ><svg\n  class='size-6'\n  fill='none'\n  viewBox='0 0 24 24'\n  xmlns='http://www.w3.org/2000/svg'\n><path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M10.1464 7.52512C10.3417 7.32986 10.6583 7.32986 10.8536 7.52512L15.0962 11.7678C15.2915 11.963 15.2915 12.2796 15.0962 12.4749L10.8536 16.7175C10.6583 16.9128 10.3417 16.9128 10.1464 16.7175C9.95118 16.5222 9.95118 16.2057 10.1464 16.0104L14.0355 12.1213L10.1464 8.23223C9.95118 8.03697 9.95118 7.72039 10.1464 7.52512Z\" fill=\"currentColor\"/></svg>\n</button>\n      </div><div class='relative overflow-hidden px-3 md:px-10'>\n      <div class='swiper !overflow-visible'>\n        <div\n          class='swiper-wrapper'\n        ><div class='swiper-slide !h-auto !overflow-visible'><div class='flex h-full flex-col overflow-hidden rounded-2xl bg-white' data-comparison-card><div class='comparison-row bg-natural-white relative'><span class='bg-natural-white-25 absolute top-3 left-3 z-10 rounded-full px-2 py-1 text-xs font-medium tracking-wider uppercase'>\n        Currently Viewing\n      </span><div class='flex aspect-[242/196] items-center justify-center overflow-hidden md:aspect-square'>\n      <img\n        :src='getCurrentImage(0)'\n        src='//www.allbirds.com/cdn/shop/files/A11959_25Q3_Tree_Runner_NZ_Medium_Grey_Blizzard_Sole_PDP_LEFT-2000x2000.png?v=1751898984&width=600'\n        alt='Men&#39;s Tree Runner NZ - Medium Grey (Blizzard Sole)'\n        class='h-full w-full object-contain object-center transition-opacity duration-300'\n        :class='imageReady[0] ? \"opacity-100\" : \"opacity-0\"'\n        @load='handleImageLoad(0)'\n        width='600'\n        height='600'\n        loading='lazy'\n      >\n    </div><div class='absolute right-2 bottom-2 z-10' data-comparison-dropdown v-cloak>\n      <button\n        class='bg-natural-white-60 flex cursor-pointer items-center gap-1 rounded-full px-2 py-1'\n        @click='toggleDropdown(0)'\n        :aria-expanded='dropdownOpen[0]'\n        aria-haspopup='listbox'\n      >\n        <span\n          class='border-light-charcoal/70 size-4 shrink-0 rounded-full border'\n          :style='getSwatchStyle(getSelectedColorway(0).hues)'\n        ></span>\n        <span\n          class='text-light-charcoal text-xs'\n          v-text='getSelectedColorway(0).colorName'\n        ></span>\n        <svg\n          class='text-light-charcoal size-4 shrink-0 transition-transform duration-200'\n          :class='{ \"rotate-180\": dropdownOpen[0] }'\n          viewBox='0 0 24 24'\n          fill='none'\n          stroke='currentColor'\n          stroke-width='2'\n        >\n          <path d='M6 9l6 6 6-6'></path>\n        </svg>\n      </button>\n\n      <div\n        v-show='dropdownOpen[0]'\n        role='listbox'\n        :aria-label='\"Select colorway for \" + productsData[0].title'\n        class='absolute top-full right-0 z-20 mt-1 max-h-60 w-max overflow-hidden overflow-y-auto rounded-2xl bg-white shadow-lg'\n      >\n        <template v-for='colorway in productsData[0].colorways'>\n          <button\n            role='option'\n            :aria-selected='selectedColorways[0] === colorway.handle'\n            class='hover:bg-natural-white-60 flex w-full cursor-pointer items-center gap-3 px-4 py-2.5 text-left'\n            :class='{ \"bg-natural-white-60\": selectedColorways[0] === colorway.handle }'\n            @click='selectColorway(0, colorway)'\n          >\n            <span\n              class='border-light-charcoal/70 size-5 shrink-0 rounded-full border'\n              :style='getSwatchStyle(colorway.hues)'\n            ></span>\n            <span class='text-sm' v-text='colorway.colorName'></span>\n          </button>\n        </template>\n      </div>\n    </div>\n  </div><div class='flex flex-1 flex-col px-3 py-4 md:px-4 md:py-5'><div class='comparison-row'>\n      <div class='flex items-baseline justify-between gap-2'>\n        <h3\n          class='text-base leading-5 md:text-xl md:leading-6'\n          v-text='productsData[0].title'\n        ></h3>\n        <span\n          class='shrink-0 text-xs font-medium tracking-wider uppercase md:text-sm'\n          v-text='formatPrice(getCurrentPrice(0))'\n        ></span>\n      </div>\n    </div><div class='comparison-row mt-3 pb-5'><p class='line-clamp-4 min-h-20 text-xs leading-5 md:line-clamp-none md:min-h-0 md:text-sm'>\n          The icon, evolved. Refreshed, modern lines. A bit more structure. Still wildly comfortable.\n        </p></div><div class='comparison-row pt-5 pb-4' ><p class='text-light-charcoal mb-2 text-xs font-medium tracking-wider uppercase'>\n            FIT & FEEL\n          </p><p class='text-xs leading-5 md:text-sm'>Structured + Supportive. Refined and roomier, with a lined upper for a classic sneaker fit.</p></div><div class='comparison-row pt-5 pb-4' ><p class='text-light-charcoal mb-2 text-xs font-medium tracking-wider uppercase'>\n            BEST FOR\n          </p><div class='flex flex-wrap gap-1'><span class='border-natural-white rounded-full border px-2 py-0.5 text-xs leading-5'>Travelling</span><span class='border-natural-white rounded-full border px-2 py-0.5 text-xs leading-5'>Walking</span><span class='border-natural-white rounded-full border px-2 py-0.5 text-xs leading-5'>Commuting</span><span class='border-natural-white rounded-full border px-2 py-0.5 text-xs leading-5'>Everyday-ing</span></div></div><div class='comparison-row pt-5 pb-4' ><p class='text-light-charcoal mb-2 text-xs font-medium tracking-wider uppercase'>\n            UPPER\n          </p><p class='text-xs leading-5 md:text-sm'>Breezy tree knit made from eucalyptus fiber. Lightly reinforced in all the right places.</p></div><div class='comparison-row pt-5 pb-4' ><p class='text-light-charcoal mb-2 text-xs font-medium tracking-wider uppercase'>\n            MIDSOLE & OUTSOLE\n          </p><p class='text-xs leading-5 md:text-sm'>A higher stack sugarcane-based SweetFoam® cushioning brings a bit more bounce.</p></div><div class='comparison-row pt-5 pb-4' ><p class='text-light-charcoal mb-2 text-xs font-medium tracking-wider uppercase'>\n            CUSHION LEVEL\n          </p><div class='pt-1'>\n              <svg\n                xmlns='http://www.w3.org/2000/svg'\n                fill='none'\n                viewBox='-8 0 496 20'\n                class='h-auto w-full overflow-visible'\n                preserveAspectRatio='xMidYMid meet'\n              >\n                <path stroke='#575757' d='M3 10H477' opacity='.3'></path><circle cx='3' cy='10' r='3' fill='#fff' stroke='#575757' stroke-width='1'></circle><circle cx='122' cy='10' r='3' fill='#fff' stroke='#575757' stroke-width='1'></circle><circle cx='240' cy='10' r='3' fill='#fff' stroke='#575757' stroke-width='1'></circle><circle cx='358' cy='10' r='3' fill='#fff' stroke='#575757' stroke-width='1'></circle><circle cx='477' cy='10' r='9' fill='#fff' stroke='#212121' stroke-width='1.5'></circle>\n                    <circle cx='477' cy='10' r='5.5' fill='#212121'></circle></svg>\n              <div class='mt-2 flex'><span class='flex-1 text-left text-xs'>B