   data-variant-title-handleized='10'\n          data-variant-title-has-parentheses='false'\n          \n          class='relative overflow-hidden'\n        >\n          <button\n            data-testid='pdp-size-selector-button-available'\n            @click='handleVariantClick(41206419226704)'\n            class='btn-size '\n            :class='\n              {\n                \"transition-standard\": hasUserInteracted,\n                \"btn-size--selected\": activeVariant && activeVariant.id === 41206419226704,\n                \"disabled\": false\n              }\n            '\n            aria-label='Select size 10'\n          >\n            \n10\n            \n          </button>\n        </li>\n      \n        \n        <li\n          data-variant-available='false'\n          data-variant-compare-at-price=''\n          data-variant-id='41206419259472'\n          data-variant-price='10000'\n          data-variant-sku='A11925M105'\n          data-variant-title='10.5'\n          data-variant-title-handleized='10-5'\n          data-variant-title-has-parentheses='false'\n          \n          class='relative overflow-hidden'\n        >\n          <button\n            data-testid='pdp-size-selector-button-oos'\n            @click='handleVariantClick(41206419259472)'\n            class='btn-size '\n            :class='\n              {\n                \"transition-standard\": hasUserInteracted,\n                \"btn-size--selected\": activeVariant && activeVariant.id === 41206419259472,\n                \"disabled\": true\n              }\n            '\n            aria-label='Select size 10.5'\n          >\n            \n10.5\n            \n              <svg\n                class='pointer-events-none absolute inset-0 z-20 size-full'\n                viewBox='0 0 10 10'\n                preserveAspectRatio='none'\n                xmlns='http://www.w3.org/2000/svg'\n              >\n                <line\n                  x1='10'\n                  y1='0'\n                  x2='0'\n                  y2='10'\n                  stroke='currentColor'\n                  stroke-width='1px'\n                  vector-effect='non-scaling-stroke'\n                />\n              </svg>\n            \n          </button>\n        </li>\n      \n        \n        <li\n          data-variant-available='true'\n          data-variant-compare-at-price=''\n          data-variant-id='41206419292240'\n          data-variant-price='10000'\n          data-variant-sku='A11925M110'\n          data-variant-title='11'\n          data-variant-title-handleized='11'\n          data-variant-title-has-parentheses='false'\n          \n          class='relative overflow-hidden'\n        >\n          <button\n            data-testid='pdp-size-selector-button-available'\n            @click='handleVariantClick(41206419292240)'\n            class='btn-size '\n            :class='\n              {\n                \"transition-standard\": hasUserInteracted,\n                \"btn-size--selected\": activeVariant && activeVariant.id === 41206419292240,\n                \"disabled\": false\n              }\n            '\n            aria-label='Select size 11'\n          >\n            \n11\n            \n          </button>\n        </li>\n      \n        \n        <li\n          data-variant-available='false'\n          data-variant-compare-at-price=''\n          data-variant-id='41206419325008'\n          data-variant-price='10000'\n          data-variant-sku='A11925M115'\n          data-variant-title='11.5'\n          data-variant-title-handleized='11-5'\n          data-variant-title-has-parentheses='false'\n          \n          class='relative overflow-hidden'\n        >\n          <button\n            data-testid='pdp-size-selector-button-oos'\n            @click='handleVariantClick(41206419325008)'\n            class='btn-size '\n            :class='\n              {\n                \"transition-standard\": hasUserInteracted,\n                \"btn-size--selected\": activeVariant && activeVariant.id === 41206419325008,\n                \"disabled\": true\n              }\n            '\n            aria-label='Select size 11.5'\n          >\n            \n11.5\n            \n              <svg\n                class='pointer-events-none absolute inset-0 z-20 size-full'\n                viewBox='0 0 10 10'\n                preserveAspectRatio='none'\n                xmlns='http://www.w3.org/2000/svg'\n              >\n                <line\n                  x1='10'\n                  y1='0'\n                  x2='0'\n                  y2='10'\n                  stroke='currentColor'\n                  stroke-width='1px'\n                  vector-effect='non-scaling-stroke'\n                />\n              </svg>\n            \n          </button>\n        </li>\n      \n        \n        <li\n          data-variant-available='true'\n          data-variant-compare-at-price=''\n          data-variant-id='41206419357776'\n          data-variant-price='10000'\n          data-variant-sku='A11925M120'\n          data-variant-title='12'\n          data-variant-title-handleized='12'\n          data-variant-title-has-parentheses='false'\n          \n          class='relative overflow-hidden'\n        >\n          <button\n            data-testid='pdp-size-selector-button-available'\n            @click='handleVariantClick(41206419357776)'\n            class='btn-size '\n            :class='\n              {\n                \"transition-standard\": hasUserInteracted,\n                \"btn-size--selected\": activeVariant && activeVariant.id === 41206419357776,\n                \"disabled\": false\n              }\n            '\n            aria-label='Select size 12'\n          >\n            \n12\n            \n          </button>\n        </li>\n      \n        \n        <li\n          data-variant-available='false'\n          data-variant-compare-at-price=''\n          data-variant-id='41206419390544'\n          data-variant-price='10000'\n          data-variant-sku='A11925M125'\n          data-variant-title='12.5'\n          data-variant-title-handleized='12-5'\n          data-variant-title-has-parentheses='false'\n          \n          class='relative overflow-hidden'\n        >\n          <button\n            data-testid='pdp-size-selector-button-oos'\n            @click='handleVariantClick(41206419390544)'\n            class='btn-size '\n            :class='\n              {\n                \"transition-standard\": hasUserInteracted,\n                \"btn-size--selected\": activeVariant && activeVariant.id === 41206419390544,\n                \"disabled\": true\n              }\n            '\n            aria-label='Select size 12.5'\n          >\n            \n12.5\n            \n              <svg\n                class='pointer-events-none absolute inset-0 z-20 size-full'\n                viewBox='0 0 10 10'\n                preserveAspectRatio='none'\n                xmlns='http://www.w3.org/2000/svg'\n              >\n                <line\n                  x1='10'\n                  y1='0'\n                  x2='0'\n                  y2='10'\n                  stroke='currentColor'\n                  stroke-width='1px'\n                  vector-effect='non-scaling-stroke'\n                />\n              </svg>\n            \n          </button>\n        </li>\n      \n        \n        <li\n          data-variant-available='false'\n          data-variant-compare-at-price=''\n          data-variant-id='41206419423312'\n          data-variant-price='10000'\n          data-variant-sku='A11925M130'\n          data-variant-title='13'\n          data-variant-title-handleized='13'\n          data-variant-title-has-parentheses='false'\n          \n          class='relative overflow-hidden'\n        >\n          <button\n            data-testid='pdp-size-selector-button-oos'\n            @click='handleVariantClick(41206419423312)'\n            class='btn-size '\n            :class='\n              {\n                \"transition-standard\": hasUserInteracted,\n                \"btn-size--selected\": activeVariant && activeVariant.id === 41206419423312,\n                \"disabled\": true\n              }\n            '\n            aria-label='Select size 13'\n          >\n            \n13\n            \n              <svg\n                class='pointer-events-none absolute inset-0 z-20 size-full'\n                viewBox='0 0 10 10'\n                preserveAspectRatio='none'\n                xmlns='http://www.w3.org/2000/svg'\n              >\n                <line\n                  x1='10'\n                  y1='0'\n                  x2='0'\n                  y2='10'\n                  stroke='currentColor'\n                  stroke-width='1px'\n                  vector-effect='non-scaling-stroke'\n                />\n              </svg>\n            \n          </button>\n        </li>\n      \n        \n        <li\n          data-variant-available='false'\n          data-variant-compare-at-price=''\n          data-variant-id='41206419456080'\n          data-variant-price='10000'\n          data-variant-sku='A11925M135'\n          data-variant-title='13.5'\n          data-variant-title-handleized='13-5'\n          data-variant-title-has-parentheses='false'\n          \n          class='relative overflow-hidden'\n        >\n          <button\n            data-testid='pdp-size-selector-button-oos'\n            @click='handleVariantClick(41206419456080)'\n            class='btn-size '\n            :class='\n              {\n                \"transition-standard\": hasUserInteracted,\n                \"btn-size--selected\": activeVariant && activeVariant.id === 41206419456080,\n                \"disabled\": true\n              }\n            '\n            aria-label='Select size 13.5'\n          >\n            \n13.5\n            \n              <svg\n                class='pointer-events-none absolute inset-0 z-20 size-full'\n                viewBox='0 0 10 10'\n                preserveAspectRatio='none'\n                xmlns='http://www.w3.org/2000/svg'\n              >\n                <line\n                  x1='10'\n                  y1='0'\n                  x2='0'\n                  y2='10'\n                  stroke='currentColor'\n                  stroke-width='1px'\n                  vector-effect='non-scaling-stroke'\n                />\n              </svg>\n            \n          </button>\n        </li>\n      \n        \n        <li\n          data-variant-available='false'\n          data-variant-compare-at-price=''\n          data-variant-id='41206419488848'\n          data-variant-price='10000'\n          data-variant-sku='A11925M140'\n          data-variant-title='14'\n          data-variant-title-handleized='14'\n          data-variant-title-has-parentheses='false'\n          \n          class='relative overflow-hidden'\n        >\n          <button\n            data-testid='pdp-size-selector-button-oos'\n            @click='handleVariantClick(41206419488848)'\n            class='btn-size '\n            :class='\n              {\n                \"transition-standard\": hasUserInteracted,\n                \"btn-size--selected\": activeVariant && activeVariant.id === 41206419488848,\n                \"disabled\": true\n              }\n            '\n            aria-label='Select size 14'\n          >\n            \n14\n            \n              <svg\n                class='pointer-events-none absolute inset-0 z-20 size-full'\n                viewBox='0 0 10 10'\n                preserveAspectRatio='none'\n                xmlns='http://www.w3.org/2000/svg'\n              >\n                <line\n                  x1='10'\n                  y1='0'\n                  x2='0'\n                  y2='10'\n                  stroke='currentColor'\n                  stroke-width='1px'\n                  vector-effect='non-scaling-stroke'\n                />\n              </svg>\n            \n          </button>\n        </li>\n      \n        \n        <li\n          data-variant-available='false'\n          data-variant-compare-at-price=''\n          data-variant-id='41206419521616'\n          data-variant-price='10000'\n          data-variant-sku='A11925M150'\n          data-variant-title='15'\n          data-variant-title-handleized='15'\n          data-variant-title-has-parentheses='false'\n          \n          class='relative overflow-hidden'\n        >\n          <button\n            data-testid='pdp-size-selector-button-oos'\n            @click='handleVariantClick(41206419521616)'\n            class='btn-size '\n            :class='\n              {\n                \"transition-standard\": hasUserInteracted,\n                \"btn-size--selected\": activeVariant && activeVariant.id === 41206419521616,\n                \"disabled\": true\n              }\n            '\n            aria-label='Select size 15'\n          >\n            \n15\n            \n              <svg\n                class='pointer-events-none absolute inset-0 z-20 size-full'\n                viewBox='0 0 10 10'\n                preserveAspectRatio='none'\n                xmlns='http://www.w3.org/2000/svg'\n              >\n                <line\n                  x1='10'\n                  y1='0'\n                  x2='0'\n                  y2='10'\n                  stroke='currentColor'\n                  stroke-width='1px'\n                  vector-effect='non-scaling-stroke'\n                />\n              </svg>\n            \n          </button>\n        </li>\n      \n    </ul>\n      <div class='text-light-charcoal flex flex-col items-start gap-1 text-xs'>\n        <p>\n          The Tree Runner NZ fits true-to-size for most customers.\n        </p>\n        <button\n          @click='openSizeChart'\n          class='cursor-pointer underline'\n        >\n          Fit Guide\n        </button>\n      </div>\n    </div>\n\n\n\n        </div>\n\n        <div\n          data-pdp-atc\n          class='flex flex-col justify-center md:h-full md:self-center'\n        >\n          \n\n<div class='flex flex-col gap-2.5' v-cloak>\n  <div class='flex-grow flex w-full flex-col items-center gap-2'>\n    <button\n      type='button'\n      class='btn btn-secondary w-full py-4 hover:border-black disabled:cursor-not-allowed disabled:border-gray-300 disabled:bg-gray-200 disabled:text-gray-400'\n      v-if='!isSizeSelected'\n      :disabled='!isSizeSelected'\n    >Select A Size</button>\n\n    <button\n      @click='handleAddToCartClick'\n      class='btn btn-secondary w-full py-4 tracking-wider hover:border-black'\n      data-testid='pdp-atc-button'\n      type='button'\n      v-show='isSizeSelected && !isUnavailableSelected'\n    >Add to Cart<span class='mx-1' v-if='formattedVariantPrice || productPrice'> - </span>\n      <span v-if='formattedVariantPrice' v-text='formattedVariantPrice'></span>\n      <span v-else>$100</span>\n    </button>\n\n    <div\n      v-show='isSizeSelected && isUnavailableSelected'\n      class='flex w-full flex-col gap-2'\n    >\n      <p class='text-red text-center text-xs'>Out of stock</p>\n      <button\n        type='button'\n        class='btn btn-outline-black btn-full py-4'\n        @click='openNotifyModal'\n      >Notify Me</button>\n    </div>\n  </div>\n\n  \n\n  \n\n\n\n<div class='m-auto flex w-fit items-center justify-center text-black mt-1 flex-col gap-1'><span class='block text-xs'>Free Shipping on Orders over $100</span><span class='block text-xs'></span></div>\n\n</div>\n\n        </div>\n      </aside>\n\n      <div\n        data-floating-container-mobile\n        class='z-navigation-content pointer-events-none fixed bottom-[0dvh] w-full rounded-t-md bg-white px-7 py-5 opacity-0'\n        :class=\"{ '!p-0': isStickyAtcVariant }\"\n      >\n        <div class='mx-auto flex flex-col gap-2.5'>\n          <div class='flex w-full justify-center gap-2 text-sm' v-if='!isStickyAtcVariant'>\n            <span>Men's Tree Runner NZ</span>\n            <span v-text='productPrice'></span>\n          </div>\n          <div class='flex  w-full  justify-center gap-4 '>\n            <button\n              type='button'\n              class='btn btn-secondary w-full py-4'\n              :class=\"{ '!rounded-none': isStickyAtcVariant }\"\n              v-show='!isSizeSelected'\n              @click='handleFloatingSelectSizeClick'\n            >\n              Select A Size\n            </button>\n            <button\n              data-testid='pdp-add-to-cart-button'\n              type='button'\n              class='btn btn-secondary w-full py-4'\n              :class=\"{ '!rounded-none': isStickyAtcVariant }\"\n              v-show='isSizeSelected && !isUnavailableSelected'\n              @click='handleAddToCartClick'\n            >\n              Add to Cart\n              <span class='mx-1' v-if='formattedVariantPrice || productPrice'> - </span>\n              <span v-if='formattedVariantPrice' v-text='formattedVariantPrice'></span>\n              <span v-else v-text='productPrice'></span>\n            </button>\n            <button\n              type='button'\n              class='btn btn-secondary w-full py-4'\n              :class=\"{ '!rounded-none': isStickyAtcVariant }\"\n              v-show='isSizeSelected && isUnavailableSelected'\n              @click='openNotifyModal'\n            >Notify Me</button>\n            \n          </div>\n        </div>\n      </div>\n    </div>\n\n    \n<div\n  v-cloak\n  v-if='isNotifyModalOpen'\n  class='z-takeover fixed inset-0 overflow-y-auto'\n  data-testid='notify-modal'\n>\n  <div class='flex min-h-screen items-center justify-center p-0'>\n    <!-- Background overlay -->\n    <div\n      class='fixed inset-0 bg-black/50 transition-opacity'\n      @click='closeNotifyModal'\n    ></div>\n\n    <!-- Modal panel -->\n    <div class='relative mt-auto h-full w-full bg-white md:mx-auto md:my-8 md:mt-0  md:h-auto md:max-h-[90vh] md:max-w-[440px] md:rounded-lg md:shadow-xl'>\n      <button\n        class='absolute top-4 right-4 z-10 flex cursor-pointer items-center justify-center text-black'\n        @click='closeNotifyModal'\n        aria-label='Close'\n      >\n        <svg\n  class='size-5'\n  fill='none'\n  viewBox='0 0 24 24'\n  xmlns='http://www.w3.org/2000/svg'\n><path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M8.31539 6.89807C8.12013 6.7028 7.80354 6.7028 7.60828 6.89807C7.41302 7.09333 7.41302 7.40991 7.60828 7.60517L11.7104 11.7073L7.31557 16.1021C7.12031 16.2974 7.12031 16.614 7.31557 16.8092C7.51083 17.0045 7.82742 17.0045 8.02268 16.8092L12.4175 12.4144L16.8007 16.7976C16.9959 16.9928 17.3125 16.9928 17.5078 16.7976C17.703 16.6023 17.703 16.2857 17.5078 16.0905L13.1246 11.7073L17.2151 7.61684C17.4103 7.42157 17.4103 7.10499 17.2151 6.90973C17.0198 6.71447 16.7032 6.71447 16.508 6.90973L12.4175 11.0002L8.31539 6.89807Z\" fill=\"currentColor\"/></svg>\n\n      </button>\n\n      <div\n        v-if='!isNotifyModalSuccess && !isNotifyModalError'\n        class='flex flex-col items-center px-6 py-10 md:px-8 md:py-14'\n      >\n        <h3 class='mb-3 text-center text-xl text-black'>Notify me when back in stock</h3>\n\n        <p class='text-light-charcoal mb-6 w-[70%] max-w-md text-center text-xs md:mb-8'>Once limited edition colors sell out, they’re gone for good. But on the upside, new colors aren’t far behind. Sign up and we’ll let you know when they’re here, along with other fun updates.</p>\n\n        <div class='w-full max-w-sm'>\n          <form @submit.prevent='handleNotifySubmit'>\n            <div class='mb-4'>\n              <label\n                for='notify-email'\n                class='mb-1 block text-left text-xs font-medium uppercase'\n                >Email</label\n              >\n              <input\n                id='notify-email'\n                type='email'\n                placeholder='Email Address'\n                class='w-full rounded-full border border-gray-300 px-4 py-2 text-base'\n                v-model='notifyEmail'\n              >\n            </div>\n\n            <button\n              type='submit'\n              class='btn btn-secondary m-auto hover:border-black'\n            >Get Notified</button>\n          </form>\n\n          <p class='mt-4 text-center text-xs'>You can opt out any time.<a href='/policies/privacy-policy' class='underline'>Privacy Policy</a>\n          </p>\n        </div>\n      </div>\n\n      <div\n        v-if='isNotifyModalSuccess'\n        class='flex flex-col items-center px-6 py-10 md:px-8 md:py-14'\n      >\n        <h3 class='mb-3 text-center text-xl text-black'>\n          It's Official\n        </h3>\n\n        <p class='text-light-charcoal mb-6 w-[80%] max-w-md text-center text-xs md:mb-8'>\n          We got your info, and we’re rooting for you. In the meantime, we’ll keep you in the loop about comfy, planet-friendly things.\n        </p>\n      </div>\n\n      <div\n        v-if='isNotifyModalError'\n        class='flex flex-col items-center px-6 py-10 md:px-8 md:py-14'\n      >\n        <h3 class='mb-3 text-center text-xl text-black'>\n          Oops! Something went wrong. Please try again.\n        </h3>\n      </div>\n    </div>\n  </div>\n</div>\n\n\n    <!-- Send as Gift Modal -->\n    \n\n<!-- Send as Gift Modal -->\n\n    <!-- Mobile Image Zoom Modal -->\n    \n\n\n  <div\n    id='image-zoom-modal'\n    class='z-takeover bg-natural-white-60 fixed inset-0 min-h-dvh md:hidden'\n    v-show=\"isModalOpen('image-zoom-modal')\"\n    v-cloak\n    data-modal-id='image-zoom-modal'\n    data-zoom-max-scale='6'\n    data-zoom-min-scale='1'\n    data-zoom-start-scale='1'\n    @touchstart='handleTouchStart'\n    @touchend='handleTouchEnd'\n  >\n    <!-- Close button (top-right corner) -->\n    <button\n      class='z-content absolute top-4 right-4 flex size-11 cursor-pointer items-center justify-center rounded-full bg-white text-black'\n      @click='closeImageZoomModal'\n      aria-label='Close zoom modal'\n    >\n      <svg\n  class='size-6'\n  fill='none'\n  viewBox='0 0 24 24'\n  xmlns='http://www.w3.org/2000/svg'\n><path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M8.31539 6.89807C8.12013 6.7028 7.80354 6.7028 7.60828 6.89807C7.41302 7.09333 7.41302 7.40991 7.60828 7.60517L11.7104 11.7073L7.31557 16.1021C7.12031 16.2974 7.12031 16.614 7.31557 16.8092C7.51083 17.0045 7.82742 17.0045 8.02268 16.8092L12.4175 12.4144L16.8007 16.7976C16.9959 16.9928 17.3125 16.9928 17.5078 16.7976C17.703 16.6023 17.703 16.2857 17.5078 16.0905L13.1246 11.7073L17.2151 7.61684C17.4103 7.42157 17.4103 7.10499 17.2151 6.90973C17.0198 6.71447 16.7032 6.71447 16.508 6.90973L12.4175 11.0002L8.31539 6.89807Z\" fill=\"currentColor\"/></svg>\n\n    </button>\n\n    <!-- Image container (centered, full viewport) -->\n    <div\n      data-image-container\n      class='relative flex h-full w-full items-center justify-center'\n    >\n      <!-- Render all product images, show/hide based on currentImageIndex -->\n      \n      \n        \n          <div\n            data-image-index='0'\n            v-show='currentImageIndex === 0'\n          >\n            \n\n  \n  <img\n    fetchpriority='auto'\n    alt='Men&#39;s Tree Runner NZ - Medium Grey (Blizzard Sole)'\n    class='block h-auto max-h-full w-auto max-w-full object-contain'\n    height='1280'\n    loading='lazy'\n    src='//www.allbirds.com/cdn/shop/files/A11959_25Q3_Tree_Runner_NZ_Medium_Grey_Blizzard_Sole_PDP_LEFT-2000x2000.png?v=1751898984&width=1280'\n    width='1280'\n    \n    \n    \n    \n      data-src-hires='//www.allbirds.com/cdn/shop/files/A11959_25Q3_Tree_Runner_NZ_Medium_Grey_Blizzard_Sole_PDP_LEFT-2000x2000.png?v=1751898984&width=2048'\n    \n    \n  >\n\n\n          </div>\n          \n        \n      \n        \n          <div\n            data-image-index='1'\n            v-show='currentImageIndex === 1'\n          >\n            \n\n  \n  <img\n    fe