sclosure_FINAL.pdf?v=1606779259'\n                          class='text-xs hover:underline'\n                        >California Transparency Act</a></li>\n                  \n                    \n                    <li>\n                      \n<a\n                          data-analytics-footer-anchor-element\n                          data-analytics-footer-link-name='Community Offers'\n                          data-analytics-footer-link-category='Company'\n                          href='/pages/community-offers'\n                          class='text-xs hover:underline'\n                        >Community Offers</a></li>\n                  \n                    \n                      \n                    \n                      \n                </ul>\n\n                \n                  <ul class='mt-3 grid gap-3 md:mt-0'>\n                    \n                      \n                        \n                      \n                        \n                      \n                        \n                      \n                        \n                      \n                        \n                      \n                        \n                      \n                        \n                      \n                        \n                      \n                      <li>\n                        <a\n                          data-analytics-footer-anchor-element\n                          data-analytics-footer-link-name='Our Blog'\n                          data-analytics-footer-link-category='Company'\n                          href='/blogs/the-perch'\n                          class='text-xs hover:underline'\n                        >Our Blog</a>\n                      </li>\n                    \n                      \n                      <li>\n                        <a\n                          data-analytics-footer-anchor-element\n                          data-analytics-footer-link-name='Patents'\n                          data-analytics-footer-link-category='Company'\n                          href='/pages/patents'\n                          class='text-xs hover:underline'\n                        >Patents</a>\n                      </li>\n                    \n                  </ul>\n                \n              </div>\n            \n          </div>\n        </div>\n      \n    </div>\n\n    <!-- Social Media Section -->\n    <div class='mb-10 flex flex-col items-center justify-center md:items-start'>\n      <h3 class='mb-6 font-mono text-xs tracking-wider uppercase max-md:text-center'>\n        Follow The Flock\n      </h3>\n      <div class='flex justify-center gap-4'>\n        \n          <a\n            href='https://www.instagram.com/allbirds'\n            class='social-icon'\n            aria-label='Instagram'\n            @click.prevent='handleSocialIconClick(\"Follow The Flock\", \"https://www.instagram.com/allbirds\", \"Instagram\")'\n          >\n            <div class='flex items-center justify-center rounded-full border border-white p-2 transition-colors hover:bg-white hover:text-black'>\n              <svg\n  width='24'\n  height='24'\n  viewBox='0 0 24 24'\n  fill='none'\n  xmlns='http://www.w3.org/2000/svg'\n>\n  <path d=\"M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.83