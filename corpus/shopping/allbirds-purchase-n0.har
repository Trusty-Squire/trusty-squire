0198 6.71447 16.7032 6.71447 16.508 6.90973L12.4175 11.0002L8.31539 6.89807Z\" fill=\"currentColor\"/></svg>\n\n          </button>\n\n          <div class='sm:flex sm:items-start'>\n            <div class='mt-3 flex flex-col items-center gap-10 text-center'>\n              <h3 class='text-center text-2xl leading-6 font-medium text-gray-900'>\n                Where are we shipping to?\n              </h3>\n\n              <!-- Country selection -->\n              <div class='mt-4 flex items-center justify-center gap-10' v-if='isSupportedCountry'>\n                <button @click='handleShopSelection(\"US\")'>\n                  <img src=\"//cdn.shopify.com/static/images/flags/us.svg?width=150\" alt=\"United States\" srcset=\"//cdn.shopify.com/static/images/flags/us.svg?width=150 150w\" width=\"150\" height=\"113\">\n                  <span class='mt-4 text-sm font-bold'>US</span>\n                </button>\n                <button\n                  data-testid='geofencing-modal-country-button'\n                  v-if='userCountryIso'\n                  @click='handleShopSelection(userCountryIso)'\n                >\n                  <span class='sr-only' v-text='userCountryIso'></span>\n                  <img\n                    :src='`//cdn.shopify.com/static/images/flags/${userCountryIso?.toLowerCase()}.svg?width=150`'\n                    width='150'\n                    height='150'\n                    :alt='userCountryIso'\n                  >\n                  <span class='mt-4 text-sm font-bold' v-text='userCountryIso'></span>\n                </button>\n              </div>\n\n              <div class='flex flex-col gap-5'>\n                <p class='text-sm'>\n                  Purchasing from your country&#39;s website is the best way to connect your feet to the world&#39;s most comfortable shoe.\n                </p>\n\n                <div class='relative w-full' v-if='!isSupportedCountry'>\n                  <select\n                    data-testid='geofencing-modal-country-selector'\n                    v-model='userSelectedShop'\n                    @change='handleShopSelection(userSelectedShop)'\n                    class='w-full rounded-md border py-2 pr-10 pl-3'\n                  >\n                    <option\n                      v-for='shop in availableShops'\n                      :key='shop.id'\n                      :value='shop.id'\n                      v-text='shop.name'\n                    ></option>\n                  </select>\n                  \n                </div>\n                <button\n                  v-if='!isSupportedCountry'\n                  class='w-full rounded-md bg-black py-3 tracking-wider text-white uppercase'\n                  @click='handleShopSelection(userSelectedShop)'\n                >\n                  Confirm\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  \n\n\n  <script src=\"//www.allbirds.com/cdn/shop/t/4159/assets/geofencing.js\" type=\"module\" crossorigin=\"anonymous\"></script>\n  <link rel=\"modulepreload\" href=\"//www.allbirds.com/cdn/shop/t/4159/assets/ScrollTrigger.js\" crossorigin=\"anonymous\">\n  <link rel=\"modulepreload\" href=\"//www.allbirds.com/cdn/shop/t/4159/assets/vue.esm-bundler.js\" crossorigin=\"anonymous\">\n  <link rel=\"modulepreload\" href=\"//www.allbirds.com/cdn/shop/t/4159/assets/cookies.js\" crossorigin=\"anonymous\">\n  <link rel=\"modulepreload\" href=\"//www.allbirds.com/cdn/shop/t/4159/assets/geofencing2.js\" crossorigin=\"anonymous\">\n  <link rel=\"modulepreload\" href=\"//www.allbirds.com/cdn/shop/t/4159/assets/base-section.js\" crossorigin=\"anonymous\">\n\n\n\n</div>\n<!-- END sections: footer-group -->\n<script type='application/ld+json'>\n  {\n    \"@context\": \"https://schema.org/\",\n    \"@type\": \"ProductGroup\",\n    \"@id\": \"#\",\n    \"productGroupID\": \"MENS_TREE_RUNNER_NZ\",\n    \"name\": \"Men's Tree Runner NZ\",\n    \"brand\": {\n      \"@type\": \"Brand\",\n      \"name\": \"Allbirds\"\n    },\n    \"description\": \"The latest iteration of our fan-fave Tree Runner, the Tree Runner NZ nods to our New Zealand roots, tying ten years of innovation together in a shoe as stylish as it is comfortable. Designed with all day wear in mind, it's the ultimate travel companion.\",\n    \"image\": [\n      \"https://www.allbirds.com/cdn/shop/files/A11959_25Q3_Tree_Runner_NZ_Medium_Grey_Blizzard_Sole_PDP_LEFT-2000x2000.png?v=1751898984&width=100\",\n      \"https://www.allbirds.com/cdn/shop/files/A11959_25Q3_Tree_Runner_NZ_Medium_Grey_Blizzard_Sole_PDP_LEFT-2000x2000.png?v=1751898984&width=300\",\n      \"https://www.allbirds.com/cdn/shop/files/A11959_25Q3_Tree_Runner_NZ_Medium_Grey_Blizzard_Sole_PDP_LEFT-2000x2000.png?v=1751898984&width=600\",\n      \"https://www.allbirds.com/cdn/shop/files/A11959_25Q3_Tree_Runner_NZ_Medium_Grey_Blizzard_Sole_PDP_LEFT-2000x2000.png?v=1751898984&width=900\"\n    ],\n    \"sku\": \"MENS_TREE_RUNNER_NZ\",\n    \"offers\": {\n      \"@type\": \"Offer\",\n      \"url\": \"https:\\/\\/www.allbirds.com\\/products\\/mens-tree-runner-nz-medium-grey\",\n      \"priceCurrency\": \"USD\",\n      \"price\": 100,\n      \"itemCondition\": \"https://schema.org/NewCondition\",\n      \"availability\": \"https://schema.org/InStock\"\n    },\n    \"variesBy\": [\n      \"https://schema.org/size\",\n      \"https://schema.org/color\"],\n    \"hasVariant\": [{\n              \"@type\": \"Product\",\n              \"url\": \"https:\\/\\/www.allbirds.com\\/products\\/mens-tree-runner-nz-blizzard-verdant-green?size=8\"\n            },{\n              \"@type\": \"Product\",\n              \"url\": \"https:\\/\\/www.allbirds.com\\/products\\/mens-tree-runner-nz-blizzard-verdant-green?size=8.5\"\n            },{\n              \"@type\": \"Product\",\n              \"url\": \"https:\\/\\/www.allbirds.com\\/products\\/mens-tree-runner-nz-blizzard-verdant-green?siz