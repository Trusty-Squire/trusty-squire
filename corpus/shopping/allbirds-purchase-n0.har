-2xl bg-white opacity-0 shadow-xl md:max-w-3xl'\n      data-post-atc-panel\n    >\n      <div class='scrollbar-hidden flex max-h-[90vh] flex-col overflow-y-auto'><div class='flex flex-col p-5 pb-6 md:p-6 md:pb-4'><div class='sticky top-0 z-10 flex items-center justify-between bg-white pb-3 md:static md:pb-4'>\n            <h2 class='text-xl font-normal md:text-2xl'>Added to Cart</h2>\n            <button\n              type='button'\n              class='flex size-8 cursor-pointer items-center justify-center'\n              aria-label='Close modal'\n              data-post-atc-close\n              @click='closePostAtcModal'\n            >\n              <svg\n  class='size-full'\n  fill='none'\n  viewBox='0 0 24 24'\n  xmlns='http://www.w3.org/2000/svg'\n><path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M8.31539 6.89807C8.12013 6.7028 7.80354 6.7028 7.60828 6.89807C7.41302 7.09333 7.41302 7.40991 7.60828 7.60517L11.7104 11.7073L7.31557 16.1021C7.12031 16.2974 7.12031 16.614 7.31557 16.8092C7.51083 17.0045 7.82742 17.0045 8.02268 16.8092L12.4175 12.4144L16.8007 16.7976C16.9959 16.9928 17.3125 16.9928 17.5078 16.7976C17.703 16.6023 17.703 16.2857 17.5078 16.0905L13.1246 11.7073L17.2151 7.61684C17.4103 7.42157 17.4103 7.10499 17.2151 6.90973C17.0198 6.71447 16.7032 6.71447 16.508 6.90973L12.4175 11.0002L8.31539 6.89807Z\" fill=\"currentColor\"/></svg>\n\n            </button>\n          </div><div v-if='freeShippingThreshold > 0' class='mb-3 flex flex-col gap-2 md:mb-4'>\n            <p class='text-light-charcoal text-xs'>\n              <span v-if='amountToFreeShipping > 0'>\n                Spend\n                <span v-text='formatMoney(amountToFreeShipping)'></span>\n                more to earn free shipping!\n              </span>\n              <span v-else v-text='modalSettings.freeShippingMessageAchieved'></span>\n            </p>\n            <div class='bg-natural-white-60 h-1.5 w-full overflow-hidden rounded-full'>\n              <div\n                class='h-full rounded-full bg-black transition-all duration-500'\n                :style='`width: ${freeShippingProgress}%`'\n              ></div>\n            </div>\n          </div><div\n            v-if='addedProduct'\n            class='mb-3 flex flex-col gap-4 md:mb-0 md:flex-row md:items-start md:gap-8'\n          ><div class='flex flex-1 items-start gap-4'>\n              <img\n                v-if='addedProduct.image'\n                :src='addedProduct.image'\n                :alt='addedProduct.title'\n                class='size-24 flex-shrink-0 object-contain'\n                width='96'\n                height='96'\n              >\n              <div class='flex min-w-0 flex-1 flex-col gap-2 pt-4'>\n                <p\n                  class='text-xs font-medium tracking-wider uppercase'\n                  v-text='addedProduct.title'\n                ></p>\n                <div class='text-light-charcoal flex flex-col gap-1 text-xs'>\n                  <p v-if='addedProduct.colorway' v-text='addedProduct.colorway'></p>\n                  <p v-if='addedProduct.size' v-text=\"'Size: ' + addedProduct.size\"></p>\n                </div>\n                <p\n                  class='text-xs font-medium tracking-wider uppercase'\n                  v-text='addedProduct.price'\n                ></p>\n              </div>\n            </div><div\n              class='border-stroke hidden w-[246px] shrink-0 border-l pl-6 md:flex md:flex-col md:gap-4'\n            >\n              <div class='flex flex-col gap-2'>\n                <div class='flex items-baseline justify-between px-1'>\n                  <span class='text-xs font-medium tracking-wider uppercase'>Shipping</span>\n                  <span class='text-xs'>\n                    <span v-if='amountToFreeShipping <= 0' class='mr-1 line-through opacity-65'\n                      >$5.00</span\n                    >\n                    <span\n                      :class=\"{ 'font-medium': amountToFreeShipping <= 0 }\"\n                      v-text=\"amountToFreeShipping <= 0 ? 'FREE' : '$5.00'\"\n                    ></span>\n                  </span>\n                </div>\n                <div class='flex items-baseline justify-between px-1'>\n                  <span class='text-xs font-medium tracking-wider uppercase'>Subtotal</span>\n                  <span class='text-xs font-medium' v-text='formatMoney(currentCartTotal)'></span>\n                </div>\n              </div>\n              <div class='flex flex-col gap-2'>\n                <button\n                  data-post-atc-modal-view-cart-button\n                  type='button'\n                  class='btn btn-secondary h-10 w-full'\n                  @click='viewCart'\n                  v-text='modalSettings.viewCartLabel'\n                ></button>\n                <button\n                  type='button'\n                  class='btn btn-outline-black h-10 w-full'\n                  @click='closePostAtcModal'\n                  v-text='modalSettings.continueShoppingLabel'\n                ></button>\n              </div>\n            </div>\n          </div><div v-if='addedProduct' class='flex flex-col gap-3 md:hidden'>\n            <button\n              type='button'\n              class='btn btn-secondary h-10 w-full'\n              @click='viewCart'\n              v-text='modalSettings.viewCartLabel'\n            ></button>\n            <button\n              type='button'\n              class='btn btn-outline-black h-10 w-full'\n              @click='closePostAtcModal'\n              v-text='modalSettings.continueShoppingLabel'\n            ></button>\n          </div>\n        </div><div\n          v-if='processedRecommendations.length > 0'\n          class='bg-natural-white-60 py-6'\n          data-post-atc-recommendations\n        ><div class='mb-2.5 flex items-center justify-between px-5 md:px-6'>\n            <h3\n              class='font-mono text-xs font-medium tracking-widest uppercase'\n              v-text='modalSettings.recommendationsTitle'\n            ></h3>\n            <div class='hidden items-center gap-1.5 md:flex'>\n              <button\n                class='btn btn-icon-black swiper-prev-button size-6 disabled:opacity-40'\n                aria-label='Previous'\n              >\n                <svg\n  class='size-6'\n  fill='none'\n  viewBox='0 0 24 24'\n  xmlns='http://www.w3.org/2000/svg'\n><path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M14.0962 16.7175C13.901 16.9128 13.5844 16.9128 13.3891 16.7175L9.14648 12.4749C8.95122 12.2796 8.95122 11.963 9.14648 11.7678L13.3891 7.52512C13.5844 7.32986 13.901 7.32986 14.0962 7.52512C14.2915 7.72038 14.2915 8.03696 14.0962 8.23222L10.2071 12.1213L14.0962 16.0104C14.2915 16.2057 14.2915 16.5222 14.0962 16.7175Z\" fill=\"currentColor\"/></svg>\n\n              </button>\n              <button\n                class='btn btn-icon-black swiper-next-button size-6 disabled:opacity-40'\n                aria-label='Next'\n              >\n                <svg\n  class='size-6'\n  fill='none'\n  viewBox='0 0 24 24'\n  xmlns='http://www.w3.org/2000/svg'\n><path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M10.1464 7.52512C10.3417 7.32986 10.6583 7.32986 10.8536 7.52512L15.0962 11.7678C15.2915 11.963 15.2915 12.2796 15.0962 12.4749L10.8536 16.7175C10.6583 16.9128 10.3417 16.9128 10.1464 16.7175C9.95118 16.5222 9.95118 16.2057 10.1464 16.0104L14.0355 12.1213L10.1464 8.23223C9.95118 8.03697 9.95118 7.72039 10.1464 7.52512Z\" fill=\"currentColor\"/></svg>\n\n              </button>\n            </div>\n          </div><div class='swiper max-h-[260px] overflow-hidden opacity-0 transition-opacity duration-200 ease-out md:max-h-[262px]'>\n            <div class='swiper-wrapper'>\n              <template\n                v-for='(item, index) in processedRecommendations'\n                :key='item.masterKey || index'\n              >\n                <div\n  class='swiper-slide md:h-full'\n  dat