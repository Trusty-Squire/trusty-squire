9/assets/vue.esm-bundler.js\" crossorigin=\"anonymous\">\n  <link rel=\"modulepreload\" href=\"//www.allbirds.com/cdn/shop/t/4159/assets/use-yotpo-composable.js\" crossorigin=\"anonymous\">\n  <link rel=\"modulepreload\" href=\"//www.allbirds.com/cdn/shop/t/4159/assets/animations.js\" crossorigin=\"anonymous\">\n  <link rel=\"modulepreload\" href=\"//www.allbirds.com/cdn/shop/t/4159/assets/base-section.js\" crossorigin=\"anonymous\">\n  <link rel=\"modulepreload\" href=\"//www.allbirds.com/cdn/shop/t/4159/assets/use-amplitude-experiment.js\" crossorigin=\"anonymous\">\n  <link rel=\"modulepreload\" href=\"//www.allbirds.com/cdn/shop/t/4159/assets/analytics-data.js\" crossorigin=\"anonymous\">\n  <link rel=\"modulepreload\" href=\"//www.allbirds.com/cdn/shop/t/4159/assets/wunderkind-api.js\" crossorigin=\"anonymous\">\n  <link rel=\"modulepreload\" href=\"//www.allbirds.com/cdn/shop/t/4159/assets/validator.js\" crossorigin=\"anonymous\">\n  <link rel=\"modulepreload\" href=\"//www.allbirds.com/cdn/shop/t/4159/assets/cookies.js\" crossorigin=\"anonymous\">\n  <link rel=\"modulepreload\" href=\"//www.allbirds.com/cdn/shop/t/4159/assets/_commonjsHelpers.js\" crossorigin=\"anonymous\">\n\n\n\n\n</section><section id=\"shopify-section-template--16476865921104__product_details_v2_htLfMX\" class=\"shopify-section\"><div\n  class='m-2.5 my-10 rounded-lg bg-white opacity-0 shadow-sm lg:rounded-none lg:bg-transparent lg:shadow-none\n'\n  data-section-id='template--16476865921104__product_details_v2_htLfMX'\n  data-section-template-name='product'\n  data-section-type='product-details-v2'\n  \n  data-product-master-handle='mens-canvas-runner-nz'\n  \n><div class='lg:hidden'><div class='border-natural-white' data-accordion='whyWeMadeThis'>\n      <button\n        class='flex w-full items-center justify-between px-4 py-4'\n        @click='handleToggleAccordion(\"whyWeMadeThis\")'\n        type='button'\n        :aria-expanded='accordionStates.whyWeMadeThis ? \"true\" : \"false\"'\n      >\n        <span class='font-mono text-sm tracking-widest text-black uppercase'>WHY WE LOVE THIS</span>\n        <span class='relative size-4 cursor-pointer'>\n          <span class='absolute top-1/2 left-0 h-px w-4 -translate-y-1/2 bg-current'></span>\n          <span\n            class='absolute top-1/2 left-0 h-px w-4 origin-center -translate-y-1/2 bg-current transition-transform duration-300'\n            :class='accordionStates.whyWeMadeThis ? \"rotate-0\" : \"rotate-90\"'\n          ></span>\n        </span>\n      </button>\n      <div class='overflow-hidden' data-accordion-content='whyWeMadeThis'>\n        <div class='px-4 pb-8'><p class='font-geograph text-base text-black'>Our bestselling Runner NZ in a crisp, canvas stripe. Just the thing for your warm weather wardrobe. Iconic Allbirds comfort in breathable hemp and tree fiber knit canvas to keep things light, easy, and ready to travel.</p><div class='mt-8'>\n              <h3 class='font-mono text-sm tracking-widest text-black uppercase'>\n                Thoughtfully designed\n              </h3>\n              <ul class='mt-3 list-disc pl-5'><li class='font-geograph mb-2 text-sm/[21px] text-black'>\n                    <strong>Hemp and TENCEL™ Lyocell (tree fiber)</strong> <strong>canvas </strong>upper<strong> </strong>is light, breathable, and durable\n                  </li><li class='font-geograph mb-2 text-sm/[21px] text-black'>\n                    <strong>Merino wool-blend lining</strong> for softness, socks optional\n                  </li><li class='font-geograph mb-2 text-sm/[21px] text-black'>\n                    Sugarcane-based <strong>SweetFoam® cushioning</strong> with responsive energy return\n                  </li><li class='font-geograph mb-2 text-sm/[21px] text-black'>\n                    Plush <strong>Featherbed™ memory foam </strong>insole for extra comfort and bounce\n                  </li></ul>\n            </div><div class='mt-8'>\n              <h3 class='font-mono text-sm tracking-widest text-black uppercase'>\n                Best for\n              </h3>\n              <div class='mt-3 flex flex-wrap gap-2'><span class='bg-natural-white-60 font-geograph rounded-full px-2 py-1 text-sm text-black'>Everyday</span><span class='bg-natural-white-60 font-geograph rounded-full px-2 py-1 text-sm text-black'>Office</span><span class='bg-natural-white-60 font-geograph rounded-full px-2 py-1 text-sm text-black'>Commuting</span><span class='bg-natural-white-60 font-geograph rounded-full px-2 py-1 text-sm text-black'>Walking</span><span class='bg-natural-white-60 font-geograph rounded-full px-2 py-1 text-sm text-black'>Warm Weather</span><span class='bg-natural-white-60 font-geograph rounded-full px-2 py-1 text-sm text-black'>Vacation</span><span class='bg-natural-white-60 font-geograph rounded-full px-2 py-1 text-sm text-black'>Weekends</span></div>\n            </div><div class='mt-8'>\n            <button\n              class='text-light-charcoal flex items-center gap-2'\n              @click='handleToggleTechDetails'\n              type='button'\n            >\n              <span\n                class='transition-transform duration-300'\n                :class='showTechDetails ? \"rotate-90\" : \"\"'\n              ><svg\n  class='size-6'\n  fill='none'\n  viewBox='0 0 24 24'\n  xmlns='http://www.w3.org/2000/svg'\n><path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M10.1464 7.52512C10.3417 7.32986 10.6583 7.32986 10.8536 7.52512L15.0962 11.7678C15.2915 11.963 15.2915 12.2796 15.0962 12.4749L10.8536 16.7175C10.6583 16.9128 10.3417 16.9128 10.1464 16.7175C9.95118 16.5222 9.95118 16.2057 10.1464 16.0104L14.0355 12.1213L10.1464 8.23223C9.95118 8.03697 9.95118 7.72039 10.1464 7.52512Z\" fill=\"currentColor\"/></svg>\n</span>\n              <span\n                class='font-geograph text-sm underline'\n                v-text='showTechDetails ? \"Hide technical details\" : \"View technical details\"'\n              ></span>\n            <