 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"9\" cy=\"9\" r=\"6\"/><line x1=\"14\" y1=\"14\" x2=\"18\" y2=\"18\"/><line x1=\"9\" y1=\"6\" x2=\"9\" y2=\"12\"/><line x1=\"6\" y1=\"9\" x2=\"12\" y2=\"9\"/></svg>\n        <span class=\"pdpgallery-zoom-text\">Zoom</span>\n      </div></div>\n</div>\n\n            </div>\n          </li>\n        \n      </ul>\n    </div>\n  </div>\n</div>\n\n<style>\n  .pdpgallery-zoom-target {\n    position: relative;\n  }\n  .pdpgallery-zoom-overlay {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%);\n    opacity: 0;\n    transition: opacity 150ms ease-out;\n    pointer-events: none;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 6px;\n    padding: 6px 10px;\n    border-radius: 9999px;\n    background: rgba(255, 255, 255, 0.85);\n    color: #000;\n  }\n  .pdpgallery-zoom-target:hover .pdpgallery-zoom-overlay {\n    opacity: 1;\n  }\n  .pdpgallery-zoom-target {\n    cursor: zoom-in;\n  }\n  .pdpgallery-zoom-svg {\n    display: block;\n  }\n  .pdpgallery-zoom-text {\n    font-size: 12px;\n    font-weight: 600;\n    letter-spacing: 0.2px;\n  }\n  .pdp-image-zoom-backdrop {\n    position: fixed;\n    inset: 0;\n    background: rgba(0, 0, 0, 0.8);\n    z-index: 100000;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 16px;\n    box-sizing: border-box;\n    overflow-y: auto;\n  }\n  .pdp-image-zoom-dialog {\n    position: relative;\n    width: min(92vw, 1100px);\n    max-height: 90vh;\n    flex-shrink: 0;\n    margin: auto;\n    box-sizing: border-box;\n  }\n  .pdp-image-zoom-frame {\n    width: 100%;\n    aspect-ratio: 4 / 5;\n    max-height: calc(90vh - 52px);\n    min-height: 0;\n    overflow: hidden;\n    background: transparent;\n    position: relative;\n    touch-action: none;\n  }\n  .pdp-image-zoom-inner {\n    position: absolute;\n    inset: 0;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    transform-origin: center center;\n    transition: transform 120ms ease-out;\n  }\n  .pdp-image-zoom-inner.is-dragging {\n    transition: none;\n  }\n  .pdp-image-zoom-img {\n    width: 100%;\n    height: 100%;\n    object-fit: contain;\n    display: block;\n    cursor: zoom-in;\n    user-select: none;\n    -webkit-user-drag: none;\n    transform-origin: center center;\n  }\n  .pdp-image-zoom-img.is-zoomed {\n    cursor: grab;\n  }\n  .pdp-image-zoom-img.is-zoomed:active {\n    cursor: grabbing;\n  }\n  .pdp-image-zoom-controls button {\n    width: 40px;\n    height: 40px;\n    border-radius: 9999px;\n    background: rgba(255,255,255,0.92);\n    color: #000;\n    border: 0;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    cursor: pointer;\n  }\n  .pdp-image-zoom-close {\n    position: absolute;\n    top: 8px;\n    right: 8px;\n    z-index: 2;\n    width: 40px;\n    height: 40px;\n    border-radius: 9999px;\n    background: rgba(255,255,255,0.92);\n    border: 0;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    cursor: pointer;\n    color: #000;\n  }\n</style>\n\n<script type=\"text/javascript\">\n  (function(w, d) {\n    w.addEventListener('load', function() {\n\n      const initGallery = () => {\n        const isMobile = window.innerWidth < 1024;\n        const container = document.getElementById('template--21163585568954__main');\n\n        if (isMobile) {\n          // Server-rendered Splide structure - no DOM replacement, just mount\n          var splide = new Splide(\"#template--21163585568954__main\", {\n            type: 'slide',\n            perPage: 1,\n            perMove: 1,\n            gap: '4px',\n            pagination: false,\n            arrows: false,\n            drag: true,\n            focus: 'center',\n            trimSpace: false,\n            padding: { right: '20%' }, // 30% padding shows next image\n            breakpoints: {\n              640: {\n                padding: { right: '12.6%' }\n              }\n            }\n          });\n\n          splide.on('mounted', () => {\n            container.classList.remove('loading');\n            // Add video click handlers for mobile\n            addVideoClickHandlers();\n\n            // Handle color swatch changes - skip to avoid double updates\n            w.addEventListener('swatch-color-changed', function(event) {\n              if (event.detail && event.detail.length > 0 && event.detail[0]?.suppressGalleryUpdate) {\n                return;\n              }\n              // Skip immediate update - wait for API response with complete media data\n            });\n\n            // Handle API response events (complete media data including videos)\n            w.addEventListener('pdp-api-response', function(event) {\n              const apiData = event.detail;\n              // Close zoom modal when gallery updates (e.g. color switch)\n              Array.from(document.querySelectorAll('.pdp-image-zoom-backdrop')).forEach((m) => {\n                document.body.style.overflow = '';\n                m.remove();\n              });\n              if (apiData?.isFirstLoad) return; // Skip gallery replace on initial load; server-rendered gallery is already correct\n              if (apiData && apiData.media && Array.isArray(apiData.media)) {\n                const list = container.querySelector('.splide__list');\n                if (!list) return;\n                const slides = Array.from(list.querySelectorAll('.splide__slide'));\n                apiData.media.forEach((mediaItem, index) => {\n                  const isVideo = mediaItem.media_type === 'video';\n                  const imageUrl = isVideo ? mediaItem.preview_image?.src : (mediaItem.src || mediaItem.preview_image?.src);\n                  const altText = isVideo ? (mediaItem.preview_image?.alt || '') : (mediaItem.alt || '');\n                  if (!imageUrl) return;\n                  if (slides[index]) {\n                    slides[index].innerHTML = getSlideInnerHtml(imageUrl, index, altText, isVideo);\n                    slides[index].dataset.index = index;\n                    slides[index].dataset.mediaType = isVideo ? 'video' : 'image';\n                    slides[index].dataset.mediaId = mediaItem.id || '';\n                  } else {\n                    list.insertAdjacentHTML('beforeend', getSlideHtmlTemplate(imageUrl, index, altText, isVideo));\n                  }\n                });\n                for (let i = slides.length - 1; i >= apiData.media.length; i--) {\n                  slides[i].remove();\n                }\n                // Defer refresh until new images load - prevents CLS from dimension recalculation\n                const newImgs = list.querySelectorAll('img');\n                const imgPromises = Array.from(newImgs).map(img =>\n                  img.decode ? img.decode().catch(() => {}) : new Promise(r => { img.complete ? r() : (img.onload = img.onerror = r); })\n                );\n                Promise.all(imgPromises).then(() => {\n                  if (typeof splide.refresh === 'function') splide.refresh();\n                }).catch(() => {\n                  if (typeof splide.refresh === 'function') splide.refresh();\n                });\n                setTimeout(() => { addVideoClickHandlers(); addZoomClickHandlers(); }, 100);\n              }\n            });\n          });\n\n          splide.mount();\n        } else {\n          // Desktop uses CSS grid - update images on color change\n          if (container) container.classList.remove('loading');\n\n          // Handle color swatch changes - skip to avoid double updates\n          w.addEventListener('swatch-color-changed', function(event) {\n            if (event.detail && event.detail.length > 0 && event.detail[0]?.suppressGalleryUpdate) {\n              return;\n            }\n            // Skip immediate update - wait for API response with complete media data\n          });\n\n          // Handle API response events (complete media data including videos)\n          w.addEventListener('pdp-api-response', function(event) {\n            const apiData = event.detail;\n            // Close zoom modal when gallery updates (e.g. color switch)\n            Array.from(document.querySelectorAll('.pdp-image-zoom-backdrop')).forEach((m) => {\n              document.body.style.overflow = '';\n              m.remove();\n            });\n            if (apiData?.isFirstLoad) return; // Skip gallery replace on initial load; server-rendered gallery is already correct\n            if (apiData && apiData.media && Array.isArray(apiData.media)) {\n              const list = container.querySelector('.splide__list');\n              if (!list) return;\n              const slides = Array.from(list.querySelectorAll('.splide__slide'));\n              // Skip DOM replacement when media is unchanged (e.g. initial color sync returns same product - prevents flash)\n              const currentFirstId = slides[0]?.dataset?.mediaId || '';\n              const apiFirstId = String(apiData.media[0]?.id ?? '');\n              if (slides.length === apiData.media.length && currentFirstId && apiFirstId && currentFirstId === apiFirstId) return;\n              apiData.media.forEach((mediaItem, index) => {\n                const isVideo = mediaItem.media_type === 'video';\n                const imageUrl = isVideo ? mediaItem.preview_image?.src : (mediaItem.src || mediaItem.preview_image?.src);\n                const altText = isVideo ? (mediaItem.preview_image?.alt || '') : (mediaItem.alt || '');\n                if (!imageUrl) return;\n                if (slides[index]) {\n                  slides[index].innerHTML = getSlideInnerHtml(imageUrl, index, altText, isVideo);\n                  slides[index].dataset.index = index;\n                  slides[index].dataset.mediaType = isVideo ? 'video' : 'image';\n                  slides[index].dataset.mediaId = mediaItem.id || '';\n                } else {\n                  list.insertAdjacentHTML('beforeend', getSlideHtmlTemplate(imageUrl, index, altText, isVideo));\n                }\n              });\n              for (let i = slides.length - 1; i >= apiData.media.length; i--) {\n                slides[i].remove();\n              }\n              setTimeout(() => { addVideoClickHandlers(); addZoomClickHandlers(); }, 50);\n            }\n          });\n        }\n\n        // Add video and zoom click handlers\n        addVideoClickHandlers();\n        addZoomClickHandlers();\n      };\n\n      const addVideoClickHandlers = () => {\n        const videoOverlays = document.querySelectorAll('.video-play-overlay');\n        videoOverlays.forEach((overlay) => {\n          overlay.addEventListener('click', (e) => {\n            e.preventDefault();\n            e.stopPropagation();\n\n            // Get index directly from the overlay element\n            const slideIndex = parseInt(overlay.dataset.index);\n            if (isNaN(slideIndex)) {\n              console.warn('Video overlay: missing data-index attribute');\n              return;\n            }\n            const mediaItem = getMediaItemByIndex(slideIndex);\n\n            if (mediaItem && mediaItem.media_type === 'video') {\n              openVideoModal(mediaItem);\n            }\n          });\n        });\n      };\n\n      const PREVIEW_WIDTH = 800;  // same as PDP display\n      const ZOOM_WIDTH = 2000;   // high-res, loaded on click\n      const toWidthUrl = (url, width) => {\n        if (!url || typeof url !== 'string') return url;\n        try {\n          const u = new URL(url);\n          u.searchParams.set('width', String(width));\n          return u.toString();\n        } catch {\n          return url + (url.includes('?') ? '&' : '?') + 'width=' + width;\n        }\n      };\n\n      const addZoomClickHandlers = () => {\n        const targets = document.querySelectorAll('.pdpgallery-zoom-target');\n        targets.forEach((el) => {\n          el.style.cursor = 'zoom-in';\n          el.addEventListener('click', (e) => {\n            e.preventDefault();\n            e.stopPropagation();\n            const slideIndex = parseInt(el.dataset.index, 10);\n            if (isNaN(slideIndex)) return;\n            const media = currentMediaData || [];\n            const imageItems = media.filter((m) => m && m.media_type === 'image');\n            const imageUrls = imageItems.map((m) => m.src || (m.preview_image && m.preview_image.src)).filter(Boolean);\n            if (imageUrls.length === 0) return;\n            const imageIndices = media.map((m, i) => (m && m.media_type === 'image' ? i : -1)).filter((i) => i >= 0);\n            let zoomIndex = imageIndices.indexOf(slideIndex);\n            if (zoomIndex < 0) zoomIndex = 0;\n            openZoomModal(imageUrls, zoomIndex);\n          });\n        });\n      };\n\n      const openZoomModal = (imageUrls, currentIndex) => {\n        const idx = Math.max(0, Math.min(currentIndex, imageUrls.length - 1));\n        const closeSvg = '<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"4\" y1=\"4\" x2=\"16\" y2=\"16\"/><line x1=\"16\" y1=\"4\" x2=\"4\" y2=\"16\"/></svg>';\n        const prevSvg = '<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"12 4 6 10 12 16\"/></svg>';\n        const nextSvg = '<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"8 4 14 10 8 16\"/></svg>';\n        let cur = idx;\n        let isZoomed = false;\n        let isHighRes = false;\n        let panX = 0, panY = 0;\n        let isDragging = false, wasDragging = false;\n        let dragStartX = 0, dragStartY = 0, startPanX = 0, startPanY = 0;\n        const backdrop = document.createElement('div');\n        backdrop.className = 'pdp-image-zoom-backdrop';\n        const close = () => { document.body.style.overflow = ''; backdrop.remove(); document.removeEventListener('keydown', keyHandler); };\n        const updateImg = (useHighRes) => {\n          const img = backdrop.querySelector('.pdp-image-zoom-img');\n          if (!img) return;\n          const w = useHighRes ? ZOOM_WIDTH : PREVIEW_WIDTH;\n          img.src = toWidthUrl(imageUrls[cur], w);\n          img.classList.toggle('is-zoomed', isZoomed);\n          img.title = isZoomed ? 'Click to zoom out' : 'Click to zoom in 3x';\n        };\n        const applyTransform = () => {\n          const inner = backdrop.querySelector('.pdp-image-zoom-inner');\n          if (!inner) return;\n          const scale = isZoomed ? 3 : 1;\n          const tx = isZoomed ? panX : 0;\n          const ty = isZoomed ? panY : 0;\n          inner.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;\n        };\n        const resetZoom = () => {\n          isZoomed = false;\n          panX = 0;\n          panY = 0;\n          isDragging = false;\n          wasDragging = false;\n          const inner = backdrop.querySelector('.pdp-image-zoom-inner');\n          if (inner) inner.classList.remove('is-dragging');\n          applyTransform();\n          const img = backdrop.querySelector('.pdp-image-zoom-img');\n          if (img) img.classList.remove('is-zoomed');\n        };\n        const onImgClick = (e) => {\n          if (wasDragging) { wasDragging = false; return; }\n          if (isZoomed) {\n            resetZoom();\n            return;\n          }\n          isZoomed = true;\n          isHighRes = true;\n          panX = 0;\n          panY = 0;\n          updateImg(true);\n          applyTransform();\n          const img = backdrop.querySelector('.pdp-image-zoom-img');\n          if (img) img.classList.add('is-zoomed');\n        };\n        const onPointerDown = (e) => {\n          if (!isZoomed) return;\n          isDragging = true;\n          wasDragging = false;\n          dragStartX = e.clientX;\n          dragStartY = e.clientY;\n          startPanX = panX;\n          startPanY = panY;\n          const inner = backdrop.querySelector('.pdp-image-zoom-inner');\n          if (inner) inner.classList.add('is-dragging');\n          e.currentTarget?.setPointerCapture?.(e.pointerId);\n        };\n        const onPointerMove = (e) => {\n          if (!isDragging) return;\n          const dx = e.clientX - dragStartX;\n          const dy = e.clientY - dragStartY;\n          if (!wasDragging && dx * dx + dy * dy > 9) wasDragging = true;\n          panX = startPanX + dx;\n          panY = startPanY + dy;\n          applyTransform();\n        };\n        const onPointerUp = () => {\n          isDragging = false;\n          const inner = backdrop.querySelector('.pdp-image-zoom-inner');\n          if (inner) inner.classList.remove('is-dragging');\n        };\n        backdrop.innerHTML = `\n          <div class=\"pdp-image-zoom-dialog\">\n            <button type=\"button\" class=\"pdp-image-zoom-close\" aria-label=\"Close\">${closeSvg}</button>\n            <div class=\"pdp-image-zoom-frame\">\n              <div class=\"pdp-image-zoom-inner\">\n                <img class=\"pdp-image-zoom-img\" src=\"${toWidthUrl(imageUrls[cur], PREVIEW_WIDTH)}\" alt=\"\" draggable=\"false\" title=\"Click to zoom in 3x\" />\n              </div>\n            </div>\n            ${imageUrls.length > 1 ? `\n              <div class=\"pdp-image-zoom-controls\" style=\"position:absolute;left:8px;top:50%;transform:translateY(-50%);z-index:2;\">\n                <button type=\"button\" aria-label=\"Previous\">${prevSvg}</button>\n              </div>\n              <div class=\"pdp-image-zoom-controls\" style=\"position:absolute;right:8px;top:50%;transform:translateY(-50%);z-index:2;\">\n                <button type=\"button\" aria-label=\"Next\">${nextSvg}</button>\n              </div>\n            ` : ''}\n          </div>\n        `;\n        const inner = backdrop.querySelector('.pdp-image-zoom-inner');\n        const img = backdrop.querySelector('.pdp-image-zoom-img');\n        inner.onclick = (e) => { e.stopPropagation(); onImgClick(e); };\n        inner.addEventListener('pointerdown', onPointerDown);\n        inner.addEventListener('pointermove', onPointerMove);\n        inner.addEventListener('pointerup', onPointerUp);\n        inner.addEventListener('pointercancel', onPointerUp);\n        backdrop.querySelector('.pdp-image-zoom-close').onclick = close;\n        backdrop.onclick = (e) => { if (e.target === backdrop) close(); };\n        const prevBtn = backdrop.querySelector('[aria-label=\"Previous\"]');\n        const nextBtn = backdrop.querySelector('[aria-label=\"Next\"]');\n        const goPrev = () => { cur = (cur - 1 + imageUrls.length) % imageUrls.length; isZoomed = false; isHighRes = false; panX = 0; panY = 0; updateImg(false); applyTransform(); };\n        const goNext = () => { cur = (cur + 1) % imageUrls.length; isZoomed = false; isHighRes = false; panX = 0; panY = 0; updateImg(false); applyTransform(); };\n        if (prevBtn) prevBtn.onclick = (e) => { e.stopPropagation(); goPrev(); };\n        if (nextBtn) nextBtn.onclick = (e) => { e.stopPropagation(); goNext(); };\n        const keyHandler = (e) => {\n          if (e.key === 'Escape') { if (isZoomed) resetZoom(); else close(); }\n          if (e.key === 'ArrowLeft') { e.preventDefault(); if (prevBtn) goPrev(); }\n          if (e.key === 'ArrowRight') { e.preventDefault(); if (nextBtn) goNext(); }\n        };\n        document.addEventListener('keydown', keyHandler);\n        document.body.style.overflow = 'hidden';\n        document.body.appendChild(backdrop);\n      };\n\n      // Store current media data for video modal functionality\n      let currentMediaData = [{\"alt\":\"Purple-Sustainable-Water-Repellent-Backpack\",\"id\":33137936400570,\"position\":1,\"preview_image\":{\"aspect_ratio\":0.8,\"height\":3600,\"width\":2880,\"src\":\"\\/\\/www.tentree.com\\/cdn\\/shop\\/files\\/Purple-Sustainable-Water-Repellent-Backpack-TAU5866-6295_4.png?v=1784935597\"},\"aspect_ratio\":0.8,\"height\":3600,\"media_type\":\"image\",\"src\":\"\\/\\/www.tentree.com\\/cdn\\/shop\\/files\\/Purple-Sustainable-Water-Repellent-Backpack-TAU5866-6295_4.png?v=1784935597\",\"width\":2880},{\"alt\":\"Purple-Sustainable-Water-Repellent-Backpack\",\"id\":33137936433338,\"position\":2,\"preview_image\":{\"aspect_ratio\":0.8,\"height\":3600,\"width\":2880,\"src\":\"\\/\\/www.tentree.com\\/cdn\\/shop\\/files\\/Purple-Sustainable-Water-Repellent-Backpack-TAU5866-6295_3.png?v=1784935597\"},\"aspect_ratio\":0.8,\"height\":3600,\"media_type\":\"image\",\"src\":\"\\/\\/www.tentree.com\\/cdn\\/shop\\/files\\/Purple-Sustainable-Water-Repellent-Backpack-TAU5866-6295_3.png?v=1784935597\",\"width\":2880},{\"alt\":\"Purple-Sustainable-Water-Repellent-Backpack\",\"id\":33137936466106,\"position\":3,\"preview_image\":{\"aspect_ratio\":0.8,\"height\":3600,\"width\":2880,\"src\":\"\\/\\/www.tentree.com\\/cdn\\/shop\\/files\\/Purple-Sustainable-Water-Repellent-Backpack-TAU5866-6295_1.png?v=1784935598\"},\"aspect_ratio\":0.8,\"height\":3600,\"media_type\":\"image\",\"src\":\"\\/\\/www.tentree.com\\/cdn\\/shop\\/files\\/Purple-Sustainable-Water-Repellent-Backpack-TAU5866-6295_1.png?v=1784935598\",\"width\":2880},{\"alt\":\"Purple-Sustainable-Water-Repellent-Backpack\",\"id\":33137936498874,\"position\":4,\"preview_image\":{\"aspect_ratio\":0.8,\"height\":3600,\"width\":2880,\"src\":\"\\/\\/www.tentree.com\\/cdn\\/shop\\/files\\/Purple-Sustainable-Water-Repellent-Backpack-TAU5866-6295_2.png?v=1784935598\"},\"aspect_ratio\":0.8,\"height\":3600,\"media_type\":\"image\",\"src\":\"\\/\\/www.tentree.com\\/cdn\\/shop\\/files\\/Purple-Sustainable-Water-Repellent-Backpack-TAU5866-6295_2.png?v=1784935598\",\"width\":2880}];\n\n      const getMediaItemByIndex = (index) => {\n        return currentMediaData[index];\n      };\n\n      // Update media data when API response arrives (skip on initial load; server-rendered data is correct)\n      w.addEventListener('pdp-api-response', function(event) {\n        if (event.detail?.isFirstLoad) return;\n        if (event.detail?.media) {\n          currentMediaData = event.detail.media;\n        }\n      });\n\n      const openVideoModal = (mediaItem) => {\n        // Create video modal\n        const modal = document.createElement('div');\n        modal.className = 'video-modal-overlay';\n\n        let videoContent = '';\n        if (mediaItem.sources && mediaItem.sources.length > 0) {\n          // Smart video source ordering for optimal quality selection\n          const orderedSources = getOptimalVideoSources(mediaItem.sources);\n\n          // Safety check: ensure we have sources to render\n          if (orderedSources && orderedSources.length > 0) {\n            // Filter out any sources with invalid URLs\n            const validSources = orderedSources.filter(source =>\n              source && source.url && typeof source.url === 'string' && source.url.trim() !== ''\n            );\n\n            if (validSources.length > 0) {\n              // Add cache busting and force reload\n              const timestamp = Date.now();\n              videoContent = `\n                <video controls autoplay playsinline key=\"${timestamp}\">\n                  ${validSources.map(source =>\n                    `<source src=\"${source.url}\" type=\"${source.mime_type || 'video/mp4'}\">`\n                  ).join('')}\n                  Your browser does not support the video tag.\n                </video>\n              `;\n\n\n            } else {\n              console.error('❌ No valid video sources after filtering');\n              videoContent = `\n                <div class=\"video-error\">\n                  <p style=\"color: white; text-align: center; padding: 20px;\">\n                    Video sources are not available.<br>\n                    <small>Please try refreshing the page.</small>\n                  </p>\n                </div>\n              `;\n            }\n          } else {\n            console.error('❌ No sources returned from getOptimalVideoSources');\n            videoContent = `\n              <div class=\"video-error\">\n                <p style=\"color: white; text-align: center; padding: 20px;\">\n                  Video processing failed.<br>\n                  <small>Please try refreshing the page.</small>\n                </p>\n              </div>\n            `;\n          }\n        } else {\n          // Fallback: Show message with media info for debugging\n          videoContent = `\n            <div class=\"video-fallback\">\n              <p style=\"color: white; text-align: center; padding: 20px;\">\n                Video playback not available.<br>\n                <small>Media ID: ${mediaItem.id}</small><br>\n                <small>Media Type: ${mediaItem.media_type}</small>\n              </p>\n            </div>\n          `;\n        }\n\n        modal.innerHTML = `\n          <div class=\"video-modal-container\">\n            <div class=\"video-modal-content\">\n              <button class=\"video-modal-close\" aria-label=\"Close video\">&times;</button>\n              <div class=\"video-wrapper\">\n                ${videoContent}\n              </div>\n            </div>\n          </div>\n        `;\n\n        // Add modal styles\n        const style = document.createElement('style');\n        style.textContent = `\n          .video-modal-overlay {\n            position: fixed;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            background: rgba(0, 0, 0, 0.9);\n            z-index: 1000;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            padding: 20px;\n            box-sizing: border-box;\n          }\n          .video-modal-container {\n            position: relative;\n            width: 100%;\n            max-width: 900px;\n            max-height: 90vh;\n          }\n          .video-modal-content {\n            position: relative;\n            background: #000;\n            border-radius: 8px;\n            overflow: hidden;\n          }\n          .video-modal-close {\n            position: absolute;\n            top: 10px;\n            right: 15px;\n            background: rgba(0, 0, 0, 0.7);\n            border: none;\n            color: white;\n            font-size: 30px;\n            cursor: pointer;\n            z-index: 1001;\n            line-height: 1;\n            width: 40px;\n            height: 40px;\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            transition: background 0.3s ease;\n          }\n          .video-modal-close:hover {\n            background: rgba(255, 255, 255, 0.2);\n          }\n          .video-wrapper {\n            width: 100%;\n            height: 100%;\n          }\n          .video-wrapper video {\n            width: 100%;\n            height: auto;\n            display: block;\n            max-height: 80vh;\n          }\n          .video-fallback {\n            min-height: 200px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n          }\n          @media (max-width: 768px) {\n            .video-modal-overlay {\n              padding: 10px;\n            }\n            .video-modal-container {\n              max-height: 95vh;\n            }\n            .video-wrapper video {\n              max-height: 70vh;\n            }\n          }\n        `;\n\n        document.head.appendChild(style);\n        document.body.appendChild(modal);\n\n\n\n        // Close modal handlers\n        const closeModal = () => {\n          document.body.removeChild(modal);\n          document.head.removeChild(style);\n        };\n\n        modal.querySelector('.video-modal-close').addEventListener('click', closeModal);\n        modal.addEventListener('click', (e) => {\n          if (e.target === modal) closeModal();\n        });\n\n        // Close on escape key\n        const handleEscape = (e) => {\n          if (e.key === 'Escape') {\n            closeModal();\n            document.removeEventListener('keydown', handleEscape);\n          }\n        };\n        document.addEventListener('keydown', handleEscape);\n      };\n\n      // Simple video source ordering - highest quality first\n      const getOptimalVideoSources = (sources) => {\n        // Safety check: ensure we have valid sources\n        if (!sources || sources.length === 0) {\n          console.warn('⚠️ No video sources provided');\n          return [];\n        }\n\n        // Filter out invalid sources\n        const validSources = sources.filter(source => {\n          return source && source.url && typeof source.url === 'string' && source.url.trim() !== '';\n        });\n\n        if (validSources.length === 0) {\n          console.warn('⚠️ No valid video sources found');\n          return sources; // Return original as fallback\n        }\n\n        // Simple approach: sort by quality indicators in URL\n        const sortedSources = [...validSources].sort((a, b) => {\n          const aUrl = a.url || '';\n          const bUrl = b.url || '';\n\n          // Get quality score based on URL patterns\n          const getScore = (url) => {\n            if (url.includes('1080p')) return 3;\n            if (url.includes('720p')) return 2;\n            if (url.includes('480p')) return 1;\n            if (url.includes('.m3u8')) return 0.5; // M3U8 as fallback\n            return 0;\n          };\n\n          return getScore(bUrl) - getScore(aUrl); // Higher quality first\n        });\n\n        return sortedSources.length > 0 ? sortedSources : sources; // Fallback to original if sorting fails\n      };\n\n      const isMobile = window.innerWidth < 1024;\n\n      if (isMobile) {\n        // Load Splide CSS immediately (not idle) to avoid CLS - layout must be correct before mount\n        const splideCssUrl = \"https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/css/splide-core.min.css\";\n        if (!document.querySelector('link[href*=\"splide-core\"]')) {\n          const link = document.createElement('link');\n          link.rel = 'stylesheet';\n          link.href = splideCssUrl;\n          document.head.appendChild(link);\n        }\n        // Load Splide JS (can be deferred)\n        loadAssetIdle(\"https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/js/splide.min.js\", \"js\", false).then(r => {\n          initGallery();\n        }).catch(e => console.error(`Error when loading asset: `, e));\n      } else {\n        // Desktop: just ensure proper CSS grid layout\n        initGallery();\n      }\n\n      // Alt: text outside * *, Label: text inside * *\n      const parseAlt = (alt) => {\n        const p = (alt || '').split('*');\n        return { cleanAlt: (p[0] || '').trim(), label: (p[1] || '').trim() };\n      };\n\n      const getSlideInnerHtml = (imageUrl, index = 0, altText = '', isVideo = false) => {\n        const { label, cleanAlt } = parseAlt(altText);\n        const zoomAttrs = !isVideo ? ` class=\"pdpgallery-zoom-target\" data-index=\"${index}\" data-media-type=\"image\"` : '';\n        return `\n          <div class=\"splide__slide__container\">\n            <div class=\"slide_content h-full\" style=\"position:relative;\">\n              <div style=\"position:relative;height:100%;\"${zoomAttrs}>\n                <picture>\n                  <source media=\"(max-width: 767px)\" srcset=\"${imageUrl}&width=300 300w, ${imageUrl}&width=500 500w, ${imageUrl}&width=800 800w\" />\n                  <source media=\"(min-width: 768px)\" srcset=\"${imageUrl}&width=300 300w, ${imageUrl}&width=500 500w, ${imageUrl}&width=800 800w\" />\n                  <img\n                    src=\"${imageUrl}&width=800\"\n                    alt=\"${cleanAlt || ''}\"\n                    srcset=\"${imageUrl}&width=300 300w, ${imageUrl}&width=500 500w, ${imageUrl}&width=800 800w\"\n                    width=\"500\"\n                    height=\"624\"\n                    sizes=\"(max-width: 767px) 100vw, (min-width: 768px) 100vw, 1000px\"\n                    class=\"w-full h-full object-cover object-center\"\n                    fetchpriority=\"${index ? 'low' : 'high'}\"\n                    decoding=\"${index ? 'async' : 'sync'}\"\n                    loading=\"${index ? 'lazy' : 'eager'}\"\n                  />\n                </picture>\n                ${isVideo ? `\n                  <div class=\"video-play-overlay\" data-index=\"${index}\" style=\"position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 2; cursor: pointer;\">\n                    <div class=\"play-button\" style=\"width: 60px; height: 60px; background: rgba(0, 0, 0, 0.7); border-radius: 50%; display: flex; align-items: center; justify-content: center; transition: all 0.3s ease;\">\n                      <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" style=\"margin-left: 2px;\">\n                        <path d=\"M8 5V19L19 12L8 5Z\" fill=\"white\"/>\n                      </svg>\n                    </div>\n                  </div>\n                ` : `\n                  <div class=\"pdpgallery-zoom-overlay\">\n                    <svg class=\"pdpgallery-zoom-svg\" xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"9\" cy=\"9\" r=\"6\"/><line x1=\"14\" y1=\"14\" x2=\"18\" y2=\"18\"/><line x1=\"9\" y1=\"6\" x2=\"9\" y2=\"12\"/><line x1=\"6\" y1=\"9\" x2=\"12\" y2=\"9\"/></svg>\n                    <span class=\"pdpgallery-zoom-text\">Zoom</span>\n                  </div>\n                `}\n                ${label ? `<div class=\"image-alt-label\">${label}</div>` : ''}\n              </div>\n            </div>\n          </div>\n      `};\n      const getSlideHtmlTemplate = (imageUrl, index = 0, altText = '', isVideo = false) => {\n        return `<li class=\"splide__slide\" data-index=\"${index}\" data-media-type=\"${isVideo ? 'video' : 'image'}\">${getSlideInnerHtml(imageUrl, index, altText, isVideo)}</li>`;\n      };\n\n      // Handle window resize to reinitialize if needed\n      let resizeTimeout;\n      window.addEventListener('resize', function() {\n        clearTimeout(resizeTimeout);\n        resizeTimeout = setTimeout(() => {\n          const newIsMobile = window.innerWidth < 1024;\n          if (newIsMobile !== isMobile) {\n            location.reload(); // Simple approach: reload on layout change\n          }\n        }, 250);\n      });\n\n    });\n  }(window, document));\n</script>\n\n      </div>\n    </div>\n\n    <!-- Right Column: Product Info -->\n    <div class=\"pdp-2025-content\">\n      <div id=\"product_attributes_container\" class=\"pdp-2025-content-inner\">\n        <div id=\"product-header-container\">\n          <div>\n            <div class=\"vue-container pdp-breadcrumb-wrapper md:mb-4\">\n              \n\n              <breadcrumb-2025\n                breadcrumb-lp1-title=\"Accessories\"\n                breadcrumb-lp1-url=\"/collections/accessories\"\n                breadcrumb-lp2-title=\"Backpacks &amp; Bags\"\n                breadcrumb-lp2-url=\"/collections/accessories-bags\"\n                breadcrumb-lp3-title=\"\"\n                breadcrumb-lp3-url=\"\"></breadcrumb-